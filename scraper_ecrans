# ------------------------------------------------------------------
# Analyse d'un écran S2i
# ------------------------------------------------------------------
def deduire_libelles(cellules):
    """Libellé d'un EF = texte ST le plus proche à sa gauche sur la même ligne,
    sinon ST juste au-dessus (même colonne, à 2 près)."""
    st_par_ligne = defaultdict(list)
    for c in cellules:
        if c["genre"] == "ST" and c["visible"] and c["texte"].strip():
            st_par_ligne[c["ligne"]].append(c)

    def nettoyer(t):
        return t.strip().rstrip(":.").strip()

    for c in cellules:
        if c["genre"] != "EF":
            continue
        gauche = [s for s in st_par_ligne.get(c["ligne"], []) if s["col"] < c["col"]]
        if gauche:
            c["libelle"] = nettoyer(max(gauche, key=lambda s: s["col"])["texte"])
            continue
        dessus = [s for s in st_par_ligne.get(c["ligne"] - 1, []) if abs(s["col"] - c["col"]) <= 2]
        c["libelle"] = nettoyer(dessus[0]["texte"]) if dessus else ""


def titre_ecran(cellules):
    st = [c for c in cellules if c["genre"] == "ST" and c["visible"] and c["texte"].strip()]
    if not st:
        return "(écran sans texte)"
    premiere = min(c["ligne"] for c in st)
    textes = [c["texte"].strip() for c in sorted(st, key=lambda c: c["col"]) if c["ligne"] == premiere]
    return " ".join(textes)[:80]


def construire_grille(cellules):
    """Reconstitue l'écran texte : ST tels quels, EF en valeur complétée par des _."""
    visibles = [c for c in cellules if c["visible"]]
    if not visibles:
        return []
    min_col = min(c["col"] for c in visibles)
    decalage = 1 if min_col >= 1 else 0

    morceaux = []
    for c in visibles:
        if c["genre"] == "EF":
            largeur = c["longueur_max"] or max(len(c["texte"]), 1)
            txt = c["texte"][:largeur].ljust(largeur, "_")
        else:
            txt = c["texte"]
        morceaux.append((c["ligne"], c["col"] - decalage, txt))

    largeur = max(col + len(t) for _, col, t in morceaux)
    lignes_min = min(l for l, _, _ in morceaux)
    lignes_max = max(l for l, _, _ in morceaux)
    grille = {l: [" "] * largeur for l in range(lignes_min, lignes_max + 1)}
    for l, col, t in morceaux:
        for i, ch in enumerate(t):
            grille[l][max(col, 0) + i] = ch

    regle = "      " +"".join(str((i + decalage) // 10 % 10) if (i + decalage) % 10 == 0 else " " for i in range(largeur))
    sortie = [regle.rstrip()]
    for l in range(lignes_min, lignes_max + 1):
        sortie.append(f"{l:>3} | " + "".join(grille[l]).rstrip())
    return sortie


