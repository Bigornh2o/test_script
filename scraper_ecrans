def lignes_resume_s2i(capture):
    lignes = construire_grille(capture["cellules"])
    lignes += ["", "  Champs de saisie (EF) :"]
    efs = sorted((c for c in capture["cellules"] if c["genre"] == "EF"), key=lambda c: (c["ligne"], c["col"]))
    if not efs:
        lignes.append("    (aucun)")
    for c in efs:
        infos = [f"max {c['longueur_max']}" if c["longueur_max"] else "", "lecture seule" if c["lecture_seule"] else "",
                 "masqué" if not c["visible"] else ""]
        infos = ", ".join(i for i in infos if i)
        lignes.append(f"    {c['id']:<10} {c.get('libelle') or '(sans libellé)':<35} valeur='{c['texte']}'"
                      + (f"   ({infos})" if infos else ""))
    touches = [t for t in capture["touches"] if t["visible"] and t["texte"]]
    if touches:
        lignes += ["", "  Touches : " + " | ".join(f"{t['id']}={t['texte']}" for t in touches)]
    return lignes


def lignes_resume_cockpit(capture):
    lignes = []
    for c in capture["champs"]:
        if c["genre"] == "section":
            lignes += ["", f"  --- {c['titre']} ---"]
        elif c["genre"] == "bouton":
            lignes.append(f"    [bouton] {c['texte']}{'  (actif)' if c['actif'] else ''}   classes: {c['classes']}")
        else:
            etoile = " *" if c.get("obligatoire") and "*" not in (c.get("libelle") or "") else ""
            details = [f"formcontrolname={c['formcontrolname'] or '-'}", f"{c['balise']}{('/' + c['type']) if c['type'] else ''}"]
            if "coche" in c:
                details.append("coché" if c["coche"] else "non coché")
            if c.get("liste_deroulante"):
                details.append(f"valeur='{c.get('valeur', '')}'")
                details.append("croix ×" if c.get("croix_pour_vider") else "pas de croix")
            elif "valeur" in c:
                details.append(f"valeur={c['valeur']}")
            if c.get("longueur_max"):
                details.append(f"max {c['longueur_max']}")
            lignes.append(f"    [champ] {c['libelle'] or '(sans libellé)'}{etoile}   " + " | ".join(details))
            if isinstance(c.get("options"), list):
                lignes.append(f"            options : {', '.join(o if o else '(vide)' for o in c['options'])}")
            elif c.get("options"):
                lignes.append(f"            options : {c['options']}")
    return lignes


def ecrire_fichiers(dossier, outil, ecran, captures):
    os.makedirs(dossier, exist_ok=True)
    entete = f"{outil}{(' - écran ' + ecran) if ecran else ''} - {datetime.now():%d/%m/%Y %H:%M}"
    lignes = [entete, f"{len(captures)} capture(s)", ""]
    for cap in captures:
        lignes += ["", "=" * 100, f"Capture {cap['numero']:02d} - {cap['heure']} - {cap['titre']}", "=" * 100]
        lignes += lignes_resume_s2i(cap) if outil == "S2i" else lignes_resume_cockpit(cap)
        with open(os.path.join(dossier, f"page_{cap['numero']:02d}.html"), "w", encoding="utf-8") as f:
            f.write(cap["html"])

    with open(os.path.join(dossier, "captures.txt"), "w", encoding="utf-8") as f:
        f.write("\n".join(lignes) + "\n")

    sans_html = [{k: v for k, v in cap.items() if k != "html"} for cap in captures]
    with open(os.path.join(dossier, "captures.json"), "w", encoding="utf-8") as f:
        json.dump({"outil": outil, "ecran": ecran, "date": datetime.now().isoformat(timespec="seconds"),
                   "captures": sans_html}, f, indent=2, ensure_ascii=False)


# ------------------------------------------------------------------
# Thread Playwright (Playwright sync et Tkinter ne partagent pas de thread)
# ------------------------------------------------------------------
class Arret(Exception):
    """Levée quand l'utilisateur termine ou ferme Chrome pendant une attente."""


class Robot(threading.Thread):
    def __init__(self, outil, ecran, chemin_mdp, dossier_sortie, masquage, file_ui):
        super().__init__(daemon=True)
        self.outil = outil
        self.ecran = ecran
        self.chemin_mdp = chemin_mdp
        self.masquage = masquage
        self.file_ui = file_ui
        self.commandes = queue.Queue()
        self.captures = []
        self.signatures = set()
        self.page = None
        horodatage = datetime.now().strftime("%Y%m%d_%H%M%S")
        self.dossier = os.path.join(dossier_sortie, f"{outil}_{ecran + '_' if ecran else ''}{horodatage}")

    # ---------- communication avec l'interface ----------
    def emettre(self, genre, **donnees):
        self.file_ui.put((genre, donnees))

    def log(self, message, niveau="info"):
        self.emettre("log", message=message, niveau=niveau)

    def etape(self, index):
        self.emettre("etape", index=index)

    def pause(self, ms):
        """Attente qui laisse Playwright traiter ses événements et détecte Chrome fermé."""
        if self.page is None or self.page.is_closed():
            raise Arret()
        try:
            self.page.wait_for_timeout(ms)
        except Exception:
            raise Arret()

    def lire_commande(self):
        try:
            return self.commandes.get_nowait()
        except queue.Empty:
            return None

    # ---------- déroulé ----------
    def run(self):
        try:
            with sync_playwright() as p:
                navigateur = p.chromium.launch(executable_path=CHROME_PATH, headless=False)
                try:
                    self.page = navigateur.new_context().new_page()
                    self.page.set_default_timeout(15000)
                    if self.outil == "S2i":
                        self.page.set_viewport_size({"width": 1300, "height": 1250})
                        self.deroule_s2i()
                    else:
                        self.page.set_viewport_size({"width": 1650, "height": 1000})
                        self.deroule_cockpit()
                except Arret:
                    self.log("Session arrêtée (Chrome fermé ou Terminer).", "attention")
                finally:
                    self.finaliser()
                    try:
                        navigateur.close()
                    except Exception:
                        pass
        except Exception as e:
            self.log(f"Erreur : {e}", "erreur")
            self.emettre("fini", dossier=None)

    def finaliser(self):
        if not self.captures:
            self.log("Aucune capture : aucun fichier écrit.", "attention")
            self.emettre("fini", dossier=None)
            return
        try:
            ecrire_fichiers(self.dossier, self.outil, self.ecran, self.captures)
            self.log(f"{len(self.captures)} capture(s) écrite(s) dans {self.dossier}", "ok")
            self.emettre("fini", dossier=self.dossier)
        except Exception as e:
            self.log(f"Écriture des fichiers impossible : {e}", "erreur")
            self.emettre("fini", dossier=None)

    def boucle(self, capture_auto):
        """Attend les commandes de l'interface ; en S2i, capture chaque nouvelle page stable."""
        candidat, depuis = None, 0.0
        while True:
            commande = self.lire_commande()
            if commande == "terminer":
                return
            if commande == "capture":
                self.capturer()

            if capture_auto:
                signature = self.signature_s2i()
                if signature:
                    if signature != candidat:
                        candidat, depuis = signature, time.monotonic()
                    elif time.monotonic() - depuis >= STABLE_CAPTURE_S and signature not in self.signatures:
                        self.capturer(signature)
            self.pause(250)

    def capturer(self, signature=None):
        try:
            if self.outil == "S2i":
                self.capturer_s2i(signature)
            else:
                self.capturer_cockpit()
        except Arret:
            raise
        except Exception as e:
            self.log(f"Capture impossible : {e}", "erreur")

    # ---------- S2i ----------
    def frame(self):
        return self.page.frame(name=FRAME_S2I)

    def texte_frame(self):
        f = self.frame()
        if f is None:
            return None
        try:
            return f.evaluate("() => document.body ? document.body.innerText : ''")
        except Exception:
            return None

    def signature_s2i(self):
        f = self.frame()
        if f is None:
            return None
        try:
            return f.evaluate(JS_S2I_SIGNATURE)
        except Exception:
            return None

    def attendre_selecteur(self, selecteur, timeout_s):
        fin = time.monotonic() + timeout_s
        while time.monotonic() < fin:
            f = self.frame()
            if f is not None:
                try:
                    if f.locator(selecteur).first.is_visible():
                        return f
                except Exception:
                    pass
            self.pause(200)
        raise TimeoutError(f"élément {selecteur} introuvable après {timeout_s} s")

    def attendre_stable(self, stable_ms, timeout_s, different_de=None):
        """Attend que le texte de l'écran ne bouge plus pendant stable_ms.
        Si different_de est donné, il faut d'abord que l'écran ait changé."""
        fin = time.monotonic() + timeout_s
        dernier, depuis, a_change = None, time.monotonic(), different_de is None
        while time.monotonic() < fin:
            t = self.texte_frame()
            if t is not None:
                if not a_change and t != different_de:
                    a_change = True
                if t != dernier:
                    dernier, depuis = t, time.monotonic()
                elif a_change and (time.monotonic() - depuis) * 1000 >= stable_ms:
                    return t
            self.pause(150)
        return None

    def lire_identifiants(self):
        import pandas as pd
        valeurs = pd.read_excel(self.chemin_mdp).values.tolist()
        return str(valeurs[0][0]).strip(), str(valeurs[0][1]).strip()

    def taper_ecran(self):
        self.page.keyboard.type(self.ecran, delay=DELAI_FRAPPE_MS)
        self.pause(300)
        self.page.keyboard.press("Enter")

    def deroule_s2i(self):
        # Étape 0 : connexion
        self.etape(0)
        utilisateur, mdp = self.lire_identifiants()
        self.log(f"Connexion à S2i avec l'utilisateur {utilisateur}...")
        self.page.goto(URL_S2I)
        try:
            self.page.wait_for_load_state("networkidle")
        except Exception:
            pass

        f = self.attendre_selecteur("#EF_4_71", 30)
        f.locator("#EF_4_71").fill(utilisateur)
        f.locator("#EF_8_71").fill(mdp)
        f.click("#entrerlib")

        try:
            f = self.attendre_selecteur('xpath=//*[@onclick="resetSession();"]', 8)
            f.click('xpath=//*[@onclick="resetSession();"]')
        except TimeoutError:
            pass  # pas de session à réinitialiser

        f = self.attendre_selecteur("#pf1", 20)
        f.click("#pf1")
        if self.attendre_stable(STABLE_LOGIN_MS, 20) is None:
            self.log("Le menu S2i met du temps à se stabiliser, on continue.", "attention")
        self.log("Connecté à S2i.", "ok")

        # Étape 1 : ouverture de l'écran (retape, puis F4 + retape si rien ne bouge)
        self.etape(1)
        self.log(f"Ouverture de l'écran {self.ecran}...")
        ouvert = None
        for essai in range(3):
            avant = self.texte_frame()
            if essai == 2:
                self.log("Rien ne bouge : retour au menu (F4) puis nouvel essai.", "attention")
                self.page.keyboard.press("F4")
                self.attendre_stable(STABLE_ECRAN_MS, 8)
                avant = self.texte_frame()
            elif essai == 1:
                self.log("Code écran probablement perdu, nouvelle frappe.", "attention")
            self.taper_ecran()
            ouvert = self.attendre_stable(STABLE_ECRAN_MS, 10, different_de=avant)
            if ouvert is not None:
                break
        if ouvert is None:
            self.log(f"L'écran {self.ecran} ne s'est pas ouvert : ouvre-le à la main dans Chrome, "
                     "la capture auto reste active.", "erreur")
        elif self.ecran not in ouvert:
            self.log(f"Écran ouvert, mais le code {self.ecran} n'apparaît pas à l'écran : vérifie dans Chrome.",
                     "attention")
        else:
            self.log(f"Écran {self.ecran} ouvert.", "ok")

        # Étape 2 : navigation libre, capture automatique
        self.etape(2)
        self.emettre("capture_dispo", actif=True)
        self.log("Capture auto active : saisis la clé si besoin et passe les pages dans Chrome.")
        self.boucle(capture_auto=True)
        self.etape(3)

    def capturer_s2i(self, signature=None):
        f = self.frame()
        if f is None:
            self.log("Frame S2i introuvable, capture ignorée.", "attention")
            return
        donnees = f.evaluate(JS_S2I_INVENTAIRE, self.masquage)
        cellules = donnees["cellules"]
        if not cellules:
            self.log("Aucun champ EF/ST sur cet écran, capture ignorée.", "attention")
            return
        deduire_libelles(cellules)
        signature = signature or self.signature_s2i()
        if signature:
            self.signatures.add(signature)
        capture = {
            "numero": len(self.captures) + 1,
            "heure": datetime.now().strftime("%H:%M:%S"),
            "titre": titre_ecran(cellules),
            "cellules": cellules,
            "touches": donnees["touches"],
            "html": donnees["html"],
        }
        self.captures.append(capture)
        nb_ef = sum(1 for c in cellules if c["genre"] == "EF")
        self.log(f"Capture {capture['numero']} : {capture['titre']} ({nb_ef} champ(s) EF)", "ok")
        self.emettre("captures", nombre=len(self.captures))

    # ---------- Cockpit ----------
    def deroule_cockpit(self):
        self.etape(0)
        self.page.goto(URL_COCKPIT, wait_until="domcontentloaded")
        self.log("Chrome ouvert sur Cockpit : connecte-toi.")
        self.emettre("capture_dispo", actif=True)
        self.etape(1)
        self.boucle(capture_auto=False)
        self.etape(3)

    def capturer_cockpit(self):
        resultat = self.page.evaluate(JS_COCKPIT_INVENTAIRE, TITRE_MODALE_COCKPIT)
        if resultat.get("erreur"):
            self.log(resultat["erreur"], "attention")
            return
        champs = resultat["champs"]
        self.log(f"{sum(1 for c in champs if c['genre'] == 'champ')} champ(s) trouvé(s), lecture des listes...")
        self.lire_options_cockpit(champs)
        capture = {
            "numero": len(self.captures) + 1,
            "heure": datetime.now().strftime("%H:%M:%S"),
            "titre": TITRE_MODALE_COCKPIT,
            "champs": champs,
            "html": resultat["html"],
        }
        self.captures.append(capture)
        self.log(f"Capture {capture['numero']} enregistrée.", "ok")
        self.emettre("captures", nombre=len(self.captures))
        self.etape(2)

    def lire_options_cockpit(self, champs):
        """Ouvre chaque liste déroulante, lit ses options puis la referme (sans rien sélectionner)."""
        for champ in champs:
            if champ.get("genre") != "champ" or not champ.get("liste_deroulante") or not champ.get("formcontrolname"):
                continue
            nom = champ["formcontrolname"]
            try:
                liste = self.page.locator(f'[formcontrolname="{nom}"]').first
                liste.scroll_into_view_if_needed()
                liste.locator(".ng-select-container, .ng-arrow-wrapper").first.click()
                self.pause(600)
                options = self.page.locator(".ng-dropdown-panel .ng-option").all_inner_texts()
                champ["options"] = [RE_CHIFFRES.sub(lambda m: "#" * len(m.group()), o.strip()) for o in options[:80]]
                if len(options) > 80:
                    champ["options"].append(f"... ({len(options)} options au total)")
            except Arret:
                raise
            except Exception as e:
                champ["options"] = f"lecture impossible : {e}"
            finally:
                try:
                    self.page.keyboard.press("Escape")
                    self.pause(300)
                except Arret:
                    raise
                except Exception:
                    pass


