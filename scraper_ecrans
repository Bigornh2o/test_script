        ctk.CTkLabel(cadre, text="Extrait la structure d'un écran S2i ou Cockpit (champs, libellés, HTML)",
                     text_color=GRIS).pack(anchor="w")

    def construire_parametres(self):
        carte = ctk.CTkFrame(self, corner_radius=12)
        carte.grid(row=1, column=0, sticky="ew", padx=20, pady=6)
        carte.grid_columnconfigure(1, weight=1)
        self.carte_param = carte

        ctk.CTkLabel(carte, text="Outil").grid(row=0, column=0, sticky="w", padx=(16, 10), pady=(14, 6))
        self.var_outil = ctk.StringVar(value=self.config_sauvee.get("outil", "S2i"))
        self.menu_outil = ctk.CTkOptionMenu(carte, values=["S2i", "Cockpit"], variable=self.var_outil,
                                            command=self.changer_outil, width=160)
        self.menu_outil.grid(row=0, column=1, sticky="w", pady=(14, 6))

        self.lbl_ecran = ctk.CTkLabel(carte, text="Écran")
        self.lbl_ecran.grid(row=1, column=0, sticky="w", padx=(16, 10), pady=6)
        self.entree_ecran = ctk.CTkEntry(carte, placeholder_text="ex. OVAL", width=160)
        self.entree_ecran.grid(row=1, column=1, sticky="w", pady=6)
        if self.config_sauvee.get("ecran"):
            self.entree_ecran.insert(0, self.config_sauvee["ecran"])
        self.entree_ecran.bind("<Return>", lambda _e: self.lancer())

        self.lbl_user = ctk.CTkLabel(carte, text="User S2i")
        self.lbl_user.grid(row=2, column=0, sticky="w", padx=(16, 10), pady=6)
        self.cadre_user = ctk.CTkFrame(carte, fg_color="transparent")
        self.cadre_user.grid(row=2, column=1, sticky="ew", padx=(0, 16), pady=6)
        self.var_user = ctk.StringVar(value=self.config_sauvee.get("user", UTILISATEURS[0]))
        self.combo_user = ctk.CTkComboBox(self.cadre_user, values=UTILISATEURS, variable=self.var_user,
                                          width=160, command=lambda _v: self.maj_chemin_mdp())
        self.combo_user.pack(side="left")
        self.lbl_chemin_mdp = ctk.CTkLabel(self.cadre_user, text="", text_color=GRIS)
        self.lbl_chemin_mdp.pack(side="left", padx=10)
        self.var_user.trace_add("write", lambda *_: self.maj_chemin_mdp())
        self.maj_chemin_mdp()

        ctk.CTkLabel(carte, text="Dossier de sortie").grid(row=3, column=0, sticky="w", padx=(16, 10), pady=6)
        _, self.entree_sortie = self.champ_chemin(
            carte, 3, self.config_sauvee.get("sortie", DOSSIER_SORTIE_DEFAUT), dossier=True)

        self.var_masquage = ctk.BooleanVar(value=self.config_sauvee.get("masquage", True))
        ctk.CTkCheckBox(carte, text="Masquer ISIN et suites de 5 chiffres ou plus",
                        variable=self.var_masquage).grid(row=4, column=1, sticky="w", pady=(6, 14))

    def user_s2i(self):
        return self.var_user.get().strip().upper()

    def maj_chemin_mdp(self):
        user = self.user_s2i()
        if not user:
            self.lbl_chemin_mdp.configure(text="")
            return
        trouve = os.path.isfile(chemin_mdp(user))
        self.lbl_chemin_mdp.configure(text=f"mdp{user}.xlsx" + ("" if trouve else "  (introuvable)"),
                                      text_color=GRIS if trouve else COULEURS_LOG["erreur"])

    def champ_chemin(self, parent, ligne, valeur, dossier):
        cadre = ctk.CTkFrame(parent, fg_color="transparent")
        cadre.grid(row=ligne, column=1, sticky="ew", padx=(0, 16), pady=6)
        cadre.grid_columnconfigure(0, weight=1)
        entree = ctk.CTkEntry(cadre)
        entree.grid(row=0, column=0, sticky="ew")
        entree.insert(0, valeur)

        def parcourir():
            if dossier:
                choix = filedialog.askdirectory(initialdir=entree.get() or DOSSIER_SCRIPT)
            else:
                choix = filedialog.askopenfilename(filetypes=[("Excel", "*.xlsx")],
                                                   initialdir=os.path.dirname(entree.get()) or DOSSIER_SCRIPT)
            if choix:
                entree.delete(0, "end")
                entree.insert(0, os.path.normpath(choix))

        ctk.CTkButton(cadre, text="…", width=36, command=parcourir).grid(row=0, column=1, padx=(6, 0))
        return cadre, entree

    def construire_consignes(self):
        carte = ctk.CTkFrame(self, corner_radius=12)
        carte.grid(row=2, column=0, sticky="ew", padx=20, pady=6)
        carte.grid_columnconfigure(1, weight=1)
        ctk.CTkLabel(carte, text="Consignes", font=ctk.CTkFont(size=15, weight="bold")).grid(
            row=0, column=0, columnspan=2, sticky="w", padx=16, pady=(12, 4))
        self.puces, self.textes_etapes = [], []
        for i in range(4):
            puce = ctk.CTkLabel(carte, text="○", width=24, font=ctk.CTkFont(size=15), text_color=GRIS)
            puce.grid(row=i + 1, column=0, sticky="nw", padx=(16, 4), pady=3)
            texte = ctk.CTkLabel(carte, text="", justify="left", anchor="w", wraplength=640, text_color=GRIS)
            texte.grid(row=i + 1, column=1, sticky="ew", padx=(0, 16), pady=3)
            self.puces.append(puce)
            self.textes_etapes.append(texte)
        ctk.CTkFrame(carte, height=8, fg_color="transparent").grid(row=6, column=0)

    def construire_actions(self):
        cadre = ctk.CTkFrame(self, fg_color="transparent")
        cadre.grid(row=3, column=0, sticky="ew", padx=20, pady=6)
        self.btn_lancer = ctk.CTkButton(cadre, text="Lancer", width=120, command=self.lancer,
                                        font=ctk.CTkFont(weight="bold"))
        self.btn_lancer.pack(side="left")
        self.btn_capturer = ctk.CTkButton(cadre, text="Capturer", width=110, command=self.capturer,
                                          fg_color="transparent", border_width=1, text_color=("gray10", "gray90"))
        self.btn_capturer.pack(side="left", padx=8)
        self.btn_terminer = ctk.CTkButton(cadre, text="Terminer", width=110, command=self.terminer,
                                          fg_color=("#b42318", "#c4322a"), hover_color=("#8f1c13", "#9e271f"))
        self.btn_terminer.pack(side="left")
        self.btn_dossier = ctk.CTkButton(cadre, text="Ouvrir le dossier", width=140, command=self.ouvrir_dossier,
                                         fg_color="transparent", border_width=1, text_color=("gray10", "gray90"))
        self.btn_dossier.pack(side="right")
        self.lbl_compteur = ctk.CTkLabel(cadre, text="0 capture", text_color=GRIS)
        self.lbl_compteur.pack(side="right", padx=12)
        self.etat_boutons(en_cours=False)

    def construire_journal(self):
        self.journal = ctk.CTkTextbox(self, corner_radius=12, font=ctk.CTkFont(family="Consolas", size=12),
                                      state="disabled", wrap="word")
        self.journal.grid(row=4, column=0, sticky="nsew", padx=20, pady=(6, 18))
        for niveau, couleur in COULEURS_LOG.items():
            mode = 1 if ctk.get_appearance_mode() == "Dark" else 0
            self.journal.tag_config(niveau, foreground=couleur[mode])

    # ---------- état de l'interface ----------
    def changer_outil(self, outil):
        s2i = outil == "S2i"
        for widget in (self.lbl_ecran, self.entree_ecran, self.lbl_user, self.cadre_user):
            widget.grid() if s2i else widget.grid_remove()
        self.afficher_etapes(-1)

    def afficher_etapes(self, courante):
        outil = self.var_outil.get()
        ecran = self.entree_ecran.get().strip().upper() or "demandé"
        for i, (puce, texte) in enumerate(zip(self.puces, self.textes_etapes)):
            libelle = ETAPES[outil][i].format(ecran=ecran)
            if i < courante:
                puce.configure(text="✓", text_color=VERT)
                texte.configure(text=libelle, text_color=GRIS, font=ctk.CTkFont())
            elif i == courante:
                puce.configure(text="●", text_color=BLEU)
                texte.configure(text=libelle, text_color=("gray10", "gray95"), font=ctk.CTkFont(weight="bold"))
            else:
                puce.configure(text="○", text_color=GRIS)
                texte.configure(text=libelle, text_color=("gray30", "gray75"), font=ctk.CTkFont())

    def etat_boutons(self, en_cours, capture_dispo=False):
        self.btn_lancer.configure(state="disabled" if en_cours else "normal")
        self.menu_outil.configure(state="disabled" if en_cours else "normal")
        self.btn_capturer.configure(state="normal" if (en_cours and capture_dispo) else "disabled")
        self.btn_terminer.configure(state="normal" if en_cours else "disabled")
        self.btn_dossier.configure(state="normal" if self.dernier_dossier else "disabled")

    def ecrire_log(self, message, niveau="info"):
        self.journal.configure(state="normal")
        self.journal.insert("end", f"[{datetime.now():%H:%M:%S}] {message}\n", niveau)
        self.journal.see("end")
        self.journal.configure(state="disabled")

    # ---------- actions ----------
    def lancer(self):
        if self.robot and self.robot.is_alive():
            return
        outil = self.var_outil.get()
        ecran = self.entree_ecran.get().strip().upper() if outil == "S2i" else ""
        if outil == "S2i":
            if not re.fullmatch(r"[A-Z0-9]{2,8}", ecran):
                messagebox.showwarning("Écran", "Indique un code écran S2i (ex. OVAL, IOVT, RRTI).")
                return
            user = self.user_s2i()
            if not user or not os.path.isfile(chemin_mdp(user)):
                messagebox.showwarning("User S2i", f"Fichier d'identifiants introuvable :\n{chemin_mdp(user)}")
                return
        if not self.entree_sortie.get().strip():
            messagebox.showwarning("Dossier de sortie", "Choisis un dossier de sortie.")
            return
        self.entree_ecran.delete(0, "end")
        self.entree_ecran.insert(0, ecran)
        self.sauver_config()

        self.journal.configure(state="normal")
        self.journal.delete("1.0", "end")
        self.journal.configure(state="disabled")
        self.lbl_compteur.configure(text="0 capture")
        self.afficher_etapes(0)

        self.robot = Robot(outil, ecran, chemin_mdp(self.user_s2i()), self.entree_sortie.get().strip(),
                           self.var_masquage.get(), self.file_ui)
        self.robot.start()
        self.etat_boutons(en_cours=True)
        self.ecrire_log(f"Lancement {outil}{(' - ' + ecran) if ecran else ''}...")

    def capturer(self):
        if self.robot and self.robot.is_alive():
            self.robot.commandes.put("capture")

    def terminer(self):
        if self.robot and self.robot.is_alive():
            self.robot.commandes.put("terminer")
            self.btn_terminer.configure(state="disabled")
            self.btn_capturer.configure(state="disabled")
            self.ecrire_log("Fin demandée, écriture des fichiers...")

    def ouvrir_dossier(self):
        if self.dernier_dossier and os.path.isdir(self.dernier_dossier):
            os.startfile(self.dernier_dossier)

    def fermer(self):
        if self.robot and self.robot.is_alive():
            if not messagebox.askyesno("Capture en cours", "Écrire les captures et fermer ?"):
                return
            self.fermer_apres = True
            self.terminer()
            return
        self.destroy()

    def lire_file_ui(self):
        try:
            while True:
                genre, d = self.file_ui.get_nowait()
                if genre == "log":
                    self.ecrire_log(d["message"], d["niveau"])
                elif genre == "etape":
                    self.afficher_etapes(d["index"])
                elif genre == "captures":
                    n = d["nombre"]
                    self.lbl_compteur.configure(text=f"{n} capture{'s' if n > 1 else ''}")
                elif genre == "capture_dispo":
                    self.etat_boutons(en_cours=True, capture_dispo=d["actif"])
                elif genre == "fini":
                    if d["dossier"]:
                        self.dernier_dossier = d["dossier"]
                        self.afficher_etapes(4)
                    self.etat_boutons(en_cours=False)
                    if self.fermer_apres:
                        self.destroy()
                        return
        except queue.Empty:
            pass
        self.after(100, self.lire_file_ui)

    # ---------- configuration ----------
    def charger_config(self):
        try:
            with open(CHEMIN_CONFIG, encoding="utf-8") as f:
                return json.load(f)
        except Exception:
            return {}

    def sauver_config(self):
        config = {"outil": self.var_outil.get(), "ecran": self.entree_ecran.get().strip().upper(),
                  "user": self.user_s2i(), "sortie": self.entree_sortie.get().strip(),
                  "masquage": self.var_masquage.get()}
        try:
            with open(CHEMIN_CONFIG, "w", encoding="utf-8") as f:
                json.dump(config, f, indent=2, ensure_ascii=False)
        except Exception:
            pass


