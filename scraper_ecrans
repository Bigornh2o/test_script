# Masquage (côté Python)
# ------------------------------------------------------------------
RE_ISIN = re.compile(r"\b[A-Z]{2}[A-Z0-9]{9}\d\b")
RE_CHIFFRES = re.compile(r"\d{5,}")


def masquer(texte):
    texte = "" if texte is None else str(texte)
    texte = RE_ISIN.sub(lambda m: m.group()[:2] + "#" * (len(m.group()) - 2), texte)
    return RE_CHIFFRES.sub(lambda m: "#" * len(m.group()), texte)


