def date_yyyymmdd_vers_fr(serie):
    """yyyymmdd (int/float/str) -> 'dd/mm/yyyy'. Vides et 0 -> NaN."""
    dates = (
        pd.to_numeric(serie, errors="coerce")
        .astype("Int64")          # supprime le .0, garde les vides en <NA>
        .astype("string")
        .replace("0", pd.NA)
    )
    return pd.to_datetime(dates, format="%Y%m%d", errors="coerce").dt.strftime("%d/%m/%Y")


def nettoyer_texte(df):
    """Strip des colonnes texte + chaînes vides -> NaN."""
    cols = df.select_dtypes(include=["object", "string"]).columns
    df[cols] = df[cols].apply(lambda s: s.str.strip()).replace("", pd.NA)
    return df


