import pandas as pd

c14 = pd.read_csv(
    r"C:\Users\ut34e9\Downloads\controle_C14.Cours_invariants_1793954691.csv",
    sep=';'
)

CHEMIN_BASE_VALEUR = r"P:\CPSI_CONTROL_DATA\SAS_DATA\02_Controles_Referentiel_Valeur\Resultat_Controle_Jour\BaseValeurfinale.csv"
CHEMIN_VCOUS = r"P:\CPSI_CONTROL_DATA\SAS_DATA\02_Controles_Referentiel_Valeur\Resultat_Controle_Jour\vcous_sas.csv"

# Load BaseValeurfinale
data_bv = pd.read_csv(
    CHEMIN_BASE_VALEUR,
    sep=';',
    encoding="ISO-8859-1",
    low_memory=False,
    dtype={"S2I_Genre": str}
)

# Load Vcous
vcous = pd.read_csv(
    CHEMIN_VCOUS,
    sep=';', 
    encoding="ISO-8859-1"
)


data_bv = data_bv[['Security_S2I', 'S2I_Date_Depart', 'S2I_Ccy']]

# Conversion yyyymmdd (int/float) -> dd/mm/yyyy
dates = (
    pd.to_numeric(data_bv["S2I_Date_Depart"], errors="coerce")
    .astype("Int64")          # supprime le .0, garde les vides en <NA>
    .astype("string")
    .replace("0", pd.NA)
)

data_bv["S2I_Date_Depart"] = pd.to_datetime(
    dates,
    format="%Y%m%d",
    errors="coerce"
).dt.strftime("%d/%m/%Y")

resultat = c14.merge(
    data_bv,
    on="Security_S2I",
    how="left"
)









print(resultat)

resultat.to_excel(
    r"C:\Users\ut34e9\Desktop\Python\Analyse_controle\analyse_c14.xlsx",
    index=False
)
