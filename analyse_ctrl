import re

import pandas as pd

# ============================================================
# CHEMINS
# ============================================================
CHEMIN_C14 = r"C:\Users\ut34e9\Downloads\controle_C14.Cours_invariants_1793954691.csv"
CHEMIN_BASE_VALEUR = r"P:\CPSI_CONTROL_DATA\SAS_DATA\02_Controles_Referentiel_Valeur\Resultat_Controle_Jour\BaseValeurfinale.csv"
CHEMIN_VCOUS = r"P:\CPSI_CONTROL_DATA\SAS_DATA\02_Controles_Referentiel_Valeur\Resultat_Controle_Jour\vcous_sas.csv"
CHEMIN_SORTIE = r"C:\Users\ut34e9\Desktop\Python\Analyse_controle\analyse_c14.xlsx"
CHEMIN_TRANSCO_PL_BRS = r"P:\CPSI_CONTROL_DATA\SAS_DATA\02_Controles_Referentiel_Valeur\DATA_INPUT\Transco_PlaceBourse_CAT.csv"


# ============================================================
# PRIVATE EQUITY (à compléter au fil de l'eau)
# ============================================================
# Mots-clés cherchés dans S2I_Security_Name (insensible à la casse)
MOTS_CLES_PE = [
    r"\bPR\.?\s*EQ",           # PR EQ, PR.EQ, PREQ
    r"\bPRIV(?:ATE)?\.?\s*EQ",   # PRIVATE EQUITY, PRIV EQ
]
# Noms de titres connus comme private equity
NOMS_PE = [
    "TIERRA CAPITAL",
    "EURAZEO",
]


# ============================================================
# OUTILS
# ============================================================
def date_yyyymmdd_vers_fr(serie):
    """yyyymmdd (int/float/str) -> 'dd/mm/yyyy'. Vides et 0 -> NaN."""
    dates = (
        pd.to_numeric(serie, errors="coerce")
        .astype("Int64")          # supprime le .0, garde les vides en <NA>
        .astype("string")
        .replace("0", pd.NA)
    )
    return pd.to_datetime(dates, format="%Y%m%d", errors="coerce").dt.strftime("%d/%m/%Y")


def code_3_car(serie):
    """Code place en texte sur 3 caractères : 4 / 4.0 -> '004', 25 -> '025', '9WY' inchangé."""
    return (
        serie.astype("string")
        .str.strip()
        .str.replace(r"\.0+$", "", regex=True)   # 4.0 -> 4
        .replace("", pd.NA)
        .str.zfill(3)
    )


def nettoyer_texte(df):
    """Strip des colonnes texte + chaînes vides -> NaN."""
    cols = df.select_dtypes(include=["object", "string"]).columns
    df[cols] = df[cols].apply(lambda s: s.str.strip()).replace("", pd.NA)
    return df


# ============================================================
# CHARGEMENT
# ============================================================
c14 = pd.read_csv(CHEMIN_C14, sep=";")

data_bv = pd.read_csv(
    CHEMIN_BASE_VALEUR,
    sep=";",
    encoding="ISO-8859-1",
    low_memory=False,
    # Colonnes absentes du fichier ignorées sans erreur
    usecols=lambda c: c in {"Security_S2I", "S2I_Date_Depart", "S2I_Ccy", "S2I_PL_BRS_CRS_EST", "S2I_Security_Name"},
    dtype={"S2I_PL_BRS_CRS_EST": str},
)

# Si le C14 a déjà ces colonnes, on garde celles du C14 (évite les colonnes _x / _y)
data_bv = data_bv.drop(columns=[c for c in ["S2I_PL_BRS_CRS_EST", "S2I_Security_Name"] if c in c14.columns], errors="ignore")

transco_pl = pd.read_csv(
    CHEMIN_TRANSCO_PL_BRS,
    sep=";",
    encoding="ISO-8859-1",
    dtype=str,
)

vcous = pd.read_csv(
    CHEMIN_VCOUS,
    sep=";",
    encoding="ISO-8859-1",
    low_memory=False,
)


# ============================================================
# NETTOYAGE BASE VALEUR
# ============================================================
data_bv["S2I_Date_Depart"] = date_yyyymmdd_vers_fr(data_bv["S2I_Date_Depart"])


# ============================================================
# NETTOYAGE VCOUS
# ============================================================
# Colonne d'index exportée par SAS/pandas (0, 1, 2...) sans nom
vcous = vcous.loc[:, ~vcous.columns.str.startswith("Unnamed")]

vcous = nettoyer_texte(vcous)

# Date de cotation : 20261105.0 -> 05/11/2026
vcous["cotation_date"] = date_yyyymmdd_vers_fr(vcous["cotation_date"])

# Code place en texte sur 3 caractères : 4.0 -> "004", 25.0 -> "025"
vcous["code_place_cotation"] = code_3_car(vcous["code_place_cotation"])


# ============================================================
# NETTOYAGE TRANSCO PLACES (S2i -> CAT)
# ============================================================
transco_pl = nettoyer_texte(transco_pl)
transco_pl["S2I_PL_BRS_CRS_EST"] = code_3_car(transco_pl["S2I_PL_BRS_CRS_EST"])
transco_pl["CAT_Code_Marche"] = code_3_car(transco_pl["CAT_Code_Marche"])

# Place S2i -> code CAT (une place S2i = un code CAT)
map_s2i_vers_cat = (
    transco_pl.dropna(subset=["S2I_PL_BRS_CRS_EST"])
    .drop_duplicates("S2I_PL_BRS_CRS_EST")
    .set_index("S2I_PL_BRS_CRS_EST")["CAT_Code_Marche"]
)

# Code CAT -> place(s) S2i (un code CAT peut correspondre à plusieurs places S2i, ex. 076 -> 9LW / 9LV)
map_cat_vers_s2i = (
    transco_pl.dropna(subset=["S2I_PL_BRS_CRS_EST", "CAT_Code_Marche"])
    .groupby("CAT_Code_Marche")["S2I_PL_BRS_CRS_EST"]
    .agg(lambda s: "/".join(sorted(s.unique())))
)

# Colonnes gardées + suffixe _VCOUS
vcous = vcous[[
    "ISIN", "cotation_date", "code_place_cotation",
    "clean_price", "currency", "foreign_local",
]].add_suffix("_VCOUS")


# ============================================================
# MERGE + EXPORT
# ============================================================
resultat = c14.merge(data_bv, on="Security_S2I", how="left")

# foreign_local : suffixe .0xx -> F, .1xx -> E
suffixe = resultat["Security_S2I"].astype("string").str.rsplit(".", n=1).str[1]
resultat["foreign_local"] = suffixe.str[0].map({"0": "F", "1": "E"})

# Merge vcous sur ISIN (partie avant le point de Security_S2I) + foreign_local + devise (S2I_Ccy)
resultat["_cle_isin"] = resultat["Security_S2I"].astype("string").str.rsplit(".", n=1).str[0]

resultat = resultat.merge(
    vcous,
    left_on=["_cle_isin", "foreign_local", "S2I_Ccy"],
    right_on=["ISIN_VCOUS", "foreign_local_VCOUS", "currency_VCOUS"],
    how="left",
).drop(columns="_cle_isin")  # 1 ligne par place de cotation (doublons attendus)


# ============================================================
# QUALIFICATION DES INVARIANCES
# ============================================================
# Veille ouvrée par rapport au jour d'exécution (lundi -> vendredi)
VEILLE_OUVREE = (pd.Timestamp.today().normalize() - pd.offsets.BDay(1)).strftime("%d/%m/%Y")

# La place a-t-elle coté hier chez le provider ?
resultat["place_active_VCOUS"] = (resultat["cotation_date_VCOUS"] == VEILLE_OUVREE).map({True: "Oui", False: "Non"})
resultat.loc[resultat["ISIN_VCOUS"].isna(), "place_active_VCOUS"] = pd.NA

# Notre place S2i traduite en code CAT
resultat["S2I_PL_BRS_CRS_EST"] = code_3_car(resultat["S2I_PL_BRS_CRS_EST"])
resultat["CAT_Code_Place_S2I"] = resultat["S2I_PL_BRS_CRS_EST"].map(map_s2i_vers_cat)

# La ligne vcous est-elle notre place S2i ?
resultat["notre_place_VCOUS"] = (
    resultat["code_place_cotation_VCOUS"] == resultat["CAT_Code_Place_S2I"]
).map({True: "Oui", False: "Non"})
resultat.loc[resultat["ISIN_VCOUS"].isna(), "notre_place_VCOUS"] = pd.NA

# Verdict par titre (toutes ses places confondues)
active = resultat["place_active_VCOUS"] == "Oui"
resultat["_active"] = active
resultat["_notre_active"] = active & (resultat["notre_place_VCOUS"] == "Oui")
resultat["_place_active"] = resultat["code_place_cotation_VCOUS"].where(active)

groupe = resultat.groupby("Security_S2I", dropna=False)
present_vcous = groupe["ISIN_VCOUS"].transform(lambda s: s.notna().any())
au_moins_une_active = groupe["_active"].transform("any")
notre_place_active = groupe["_notre_active"].transform("any")
sans_transco = resultat["CAT_Code_Place_S2I"].isna()

resultat["verdict_invariance"] = "Vraie invariance"
resultat.loc[au_moins_une_active, "verdict_invariance"] = "Mauvaise place S2i probable"
resultat.loc[au_moins_une_active & sans_transco, "verdict_invariance"] = "Fausse invariance probable (place S2i sans transco)"
resultat.loc[notre_place_active, "verdict_invariance"] = "Notre place cote : problème en amont"
resultat.loc[~present_vcous, "verdict_invariance"] = "Absent vcous"

# Places actives hier chez le provider (codes CAT) et leur équivalent S2i
places_actives = groupe["_place_active"].transform(lambda s: "/".join(sorted(s.dropna().unique())))
resultat["places_actives_CAT"] = places_actives.replace("", pd.NA)
resultat["places_S2I_proposees"] = resultat["places_actives_CAT"].map(
    lambda codes: "/".join(map_cat_vers_s2i.get(c, f"{c}?") for c in codes.split("/")) if isinstance(codes, str) else pd.NA
)
resultat.loc[resultat["verdict_invariance"] != "Mauvaise place S2i probable", "places_S2I_proposees"] = pd.NA

resultat = resultat.drop(columns=["_active", "_notre_active", "_place_active"])

# Private equity : mots-clés ou nom connu dans le libellé
motif_pe = "|".join(MOTS_CLES_PE + [re.escape(n) for n in NOMS_PE])
est_pe = resultat["S2I_Security_Name"].astype("string").str.contains(motif_pe, case=False, regex=True, na=False)
resultat["private_equity"] = est_pe.map({True: "Oui", False: "Non"})


# ============================================================
# ACTION À MENER
# ============================================================
ACTIONS = {
    "Vraie invariance": "Interroger CAT : titre éteint ou MAJ du cours ?",
    "Absent vcous": "Interroger CAT : titre inconnu ou mal catégorisé ?",
    "Mauvaise place S2i probable": "Corriger la place S2i (voir places_S2I_proposees)",
    "Notre place cote : problème en amont": "Vérifier le flux / l'alimentation du cours",
    "Fausse invariance probable (place S2i sans transco)": "Compléter la transco des places",
}
resultat["action"] = resultat["verdict_invariance"].map(ACTIONS)
resultat.loc[est_pe, "action"] = "Interroger l'équipe Private Equity (mode de valorisation)"

print(f"Veille ouvrée de référence : {VEILLE_OUVREE}")
print(resultat)

resultat.to_excel(CHEMIN_SORTIE, index=False)
