        for name, btn in mapping.items():
            if selected_statement["value"] == name:
                btn.config(bg=BLUE, fg=WHITE, activebackground=BLUE, activeforeground=WHITE)
            else:
                btn.config(bg=WHITE, fg=TEXT_DARK, activebackground="#efefef", activeforeground=TEXT_DARK)

