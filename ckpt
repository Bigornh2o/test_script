            "Annual_perf_history": DEFAULT_GUI_VALUES["Annual_perf_history"],
            "Anonymized_document": DEFAULT_GUI_VALUES["Anonymized_document"],
            "Client_signature": DEFAULT_GUI_VALUES["Client_signature"],
        })

    return pd.DataFrame(lignes, columns=GUI_COLUMNS)


def lire_lignes_depuis_df(df):
    colonnes_obligatoires = [
        "N_intv",
        "Date",
        "Statement_type",
        "Performance_type",
        "Est_currency",
        "Language",
        "Monthly_perf_history",
        "Annual_perf_history",
        "Anonymized_document",
        "Client_signature",
    ]

    for col in colonnes_obligatoires:
        if col not in df.columns:
            raise ValueError(f"La colonne '{col}' est introuvable dans le DataFrame.")

    resultats = []
    for _, row in df.iterrows():
        n_intv = clean_n_intv(row["N_intv"])
        if not n_intv:
            continue

        resultats.append({
            "N_intv": n_intv,
            "Date": normaliser_date(row["Date"]),
            "StatementType": normaliser_statement_type(row["Statement_type"]),
            "PerformanceType": normaliser_texte(row["Performance_type"]),
            "Est_currency": normaliser_texte(row["Est_currency"]),
            "Language": normaliser_texte(row["Language"]),
            "Monthly_perf_history": normaliser_texte(row["Monthly_perf_history"]),
            "Annual_perf_history": normaliser_texte(row["Annual_perf_history"]),
            "Anonymized_document": to_bool(row["Anonymized_document"]),
            "Client_signature": to_bool(row["Client_signature"]),
        })

    return resultats


def contient_n_intv(texte, n_intv):
    return re.search(rf"(?<!\d){re.escape(n_intv)}(?!\d)", texte or "") is not None


def contient_n_intv_souple(texte, n_intv):
    n = str(n_intv).lstrip("0") or "0"
    return re.search(rf"(?<!\d)0*{re.escape(n)}(?!\d)", texte or "") is not None


def extraire_n_intv_depuis_texte(texte):
    if not texte:
        return []

    morceaux = re.split(r"[\s,;\n\r\t]+", texte)
    resultats = []
    vus = set()

    for m in morceaux:
        n = clean_n_intv(m)
        if n and n not in vus:
            vus.add(n)
            resultats.append(n)

    return resultats


def charger_n_intv_depuis_xlsx(chemin_fichier):
    df = pd.read_excel(chemin_fichier)

    col_trouvee = None
    for c in df.columns:
        if str(c).strip().lower() in ["n_intv", "n intv", "relationship number", "relationship_number"]:
            col_trouvee = c
            break

    if col_trouvee is None:
        if len(df.columns) == 1:
            col_trouvee = df.columns[0]
        else:
            raise ValueError(
                "Impossible d'identifier la colonne des N_intv dans le fichier chargé. "
                "Merci d'utiliser une colonne nommée 'N_intv'."
            )

    liste = []
    vus = set()
    for val in df[col_trouvee]:
        n = clean_n_intv(val)
        if n and n not in vus:
            vus.add(n)
            liste.append(n)

    return liste


