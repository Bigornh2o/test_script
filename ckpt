class _Bouton(ctk.CTkButton):
    """CTkButton avec variantes de style et couleur grisée quand il est désactivé."""

    def __init__(self, master, variante="secondaire", **kwargs):
        styles = dict(_STYLES_BOUTON[variante])
        self._fg_actif = styles["fg_color"]
        self._fg_inactif = styles.pop("_fg_disabled", styles["fg_color"])
        options = dict(corner_radius=8, height=36, font=ctk.CTkFont(family=UI_FONT, size=13), cursor="hand2")
        options.update(styles)
        options.update(kwargs)
        if options.get("state") == "disabled":
            options["fg_color"] = self._fg_inactif
        super().__init__(master, **options)

    def configure(self, require_redraw=False, **kwargs):
        if "state" in kwargs and "fg_color" not in kwargs:
            kwargs["fg_color"] = self._fg_inactif if kwargs["state"] == "disabled" else self._fg_actif
        super().configure(require_redraw=require_redraw, **kwargs)


def _accorder(n, aucun, singulier, pluriel):
    """Choisit le texte selon n (0, 1 ou plusieurs). {n} est remplacé par le nombre."""
    if n == 0:
        texte = aucun
    elif n == 1:
        texte = singulier
    else:
        texte = pluriel
    return texte.format(n=n)


def _police(size=13, weight="normal"):
    return ctk.CTkFont(family=UI_FONT, size=size, weight=weight)


def _carte(parent, titre=None, droite=None):
    """Carte blanche arrondie avec titre optionnel. Retourne (carte, entête, corps)."""
    carte = ctk.CTkFrame(parent, fg_color=UI_CARD, corner_radius=12, border_width=1, border_color=UI_BORDER)
    entete = None
    if titre:
        entete = ctk.CTkFrame(carte, fg_color="transparent")
        entete.pack(fill="x", padx=18, pady=(14, 0))
        ctk.CTkLabel(entete, text=titre, font=_police(14, "bold"), text_color=UI_TEXT).pack(side="left")
    corps = ctk.CTkFrame(carte, fg_color="transparent")
    corps.pack(fill="both", expand=True, padx=18, pady=(10, 16))
    return carte, entete, corps


def _libelle_champ(parent, texte):
    return ctk.CTkLabel(parent, text=texte, font=_police(12, "bold"), text_color=UI_MUTED, anchor="w")


def _liste_deroulante(parent, variable, values, **kwargs):
    options = dict(
        variable=variable, values=values, height=36, corner_radius=8,
        fg_color=UI_FIELD, button_color=UI_FIELD, button_hover_color=UI_FIELD_HOVER,
        text_color=UI_TEXT, text_color_disabled="#A0A7B4",
        dropdown_fg_color=UI_CARD, dropdown_hover_color=UI_HOVER_LIGHT, dropdown_text_color=UI_TEXT,
        font=_police(13), dropdown_font=_police(13), dynamic_resizing=False, anchor="w",
    )
    options.update(kwargs)
    return ctk.CTkOptionMenu(parent, **options)


