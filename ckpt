    actuel = champ.input_value().strip()
    attendu = str(date_value).strip()

    try:
        actuel_norm = normaliser_date(actuel) if actuel else ""
    except Exception:
        actuel_norm = actuel

    try:
        attendu_norm = normaliser_date(attendu) if attendu else ""
    except Exception:
        attendu_norm = attendu

    if actuel_norm == attendu_norm:
        log(f"Date déjà correcte : {actuel_norm}")
        return

    log(f"Mise à jour Date : '{actuel}' -> '{attendu_norm}'")
    champ.scroll_into_view_if_needed()
    champ.click()
    champ.press("Control+A")
    champ.press("Backspace")
    champ.fill(attendu_norm)


