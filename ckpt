_DPAPI_ENTROPIE = b"Robot_Cockpit"


def _dpapi(donnees, chiffrer):
    """Chiffre/déchiffre avec DPAPI : lié à la session Windows de l'utilisateur."""
    if os.name != "nt":
        raise RuntimeError("Le chiffrement DPAPI n'est disponible que sous Windows.")

    import ctypes
    from ctypes import wintypes

    class DATA_BLOB(ctypes.Structure):
        _fields_ = [("cbData", wintypes.DWORD), ("pbData", ctypes.POINTER(ctypes.c_char))]

    def blob(octets):
        tampon = ctypes.create_string_buffer(octets, len(octets))
        return DATA_BLOB(len(octets), ctypes.cast(tampon, ctypes.POINTER(ctypes.c_char))), tampon

    entree, _tampon_entree = blob(donnees)
    entropie, _tampon_entropie = blob(_DPAPI_ENTROPIE)
    sortie = DATA_BLOB()

    CRYPTPROTECT_UI_FORBIDDEN = 0x01
    crypt32 = ctypes.windll.crypt32
    fonction = crypt32.CryptProtectData if chiffrer else crypt32.CryptUnprotectData

    ok = fonction(
        ctypes.byref(entree), None, ctypes.byref(entropie),
        None, None, CRYPTPROTECT_UI_FORBIDDEN, ctypes.byref(sortie)
    )
    if not ok:
        raise ctypes.WinError()

    try:
        return ctypes.string_at(sortie.pbData, sortie.cbData)
    finally:
        ctypes.windll.kernel32.LocalFree(sortie.pbData)


def chiffrer_mot_de_passe(mot_de_passe):
    return base64.b64encode(_dpapi(mot_de_passe.encode("utf-8"), chiffrer=True)).decode("ascii")


def dechiffrer_mot_de_passe(valeur):
    return _dpapi(base64.b64decode(valeur), chiffrer=False).decode("utf-8")


def charger_identifiants_pour_utilisateur(config, ut_code):
    """Retourne (username, password). password vaut None s'il est absent ou illisible."""
    bloc = get_user_cfg(config, ut_code).get("identifiants", {})
    if not isinstance(bloc, dict):
        return "", None

    username = str(bloc.get("username", "")).strip()
    chiffre = bloc.get("password_dpapi", "")
    if not username or not chiffre:
        return username, None

    try:
        return username, dechiffrer_mot_de_passe(chiffre)
    except Exception as e:
        log(f"ATTENTION : mot de passe enregistré illisible ({e}), nouvelle saisie nécessaire.")
        return username, None


def sauvegarder_identifiants_pour_utilisateur(config, ut_code, username, password):
    get_user_cfg(config, ut_code)["identifiants"] = {
        "username": str(username).strip(),
        "password_dpapi": chiffrer_mot_de_passe(password),
        "mis_a_jour_le": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
