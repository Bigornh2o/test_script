        if not valider_formulaire(afficher_message_succes=False):
            return

        nom = simpledialog.askstring("Enregistrer paramétrage", "Nom du paramétrage :", parent=root)
        if nom is None:
            return

        nom = nom.strip()
        if not nom:
            return

        presets = get_presets_pour_utilisateur(config, ut_code)

        if nom in presets:
            if not messagebox.askyesno("Paramétrage existant", f"« {nom} » existe déjà. Remplacer ?"):
                return

        presets[nom] = get_params_preset()
        sauvegarder_config(config)
        refresh_preset_combo(select=nom)
        set_reference_state()
        lbl_status.config(text=f"✓ Preset enregistré : {nom}", fg=GREEN)
        log(f"Preset enregistré pour {ut_code} : {nom}")

    def charger_preset(event=None):
        nom = var_preset.get().strip()
        if not nom:
            update_delete_button()
            preset_precedent["value"] = ""
            return

        if formulaire_modifie_depuis_reference():
            ok = messagebox.askyesno(
                "Charger un paramétrage",
                "Le formulaire contient des modifications non enregistrées.\nCharger le paramétrage quand même ?"
            )
            if not ok:
                var_preset.set(preset_precedent["value"])
                update_delete_button()
                return

        preset = get_presets_pour_utilisateur(config, ut_code).get(nom)
        if not isinstance(preset, dict):
            messagebox.showerror("Preset", f"Impossible de charger le paramétrage « {nom} ».")
            var_preset.set(preset_precedent["value"])
            update_delete_button()
            return

        appliquer_preset_sur_formulaire(normalize_preset_payload(preset))
        preset_precedent["value"] = nom
        set_reference_state()
        update_delete_button()
        lbl_status.config(text=f"✓ Paramétrage chargé : {nom}", fg=GREEN)

    def supprimer_preset():
        nom = var_preset.get().strip()
        if not nom:
            return

        if not messagebox.askyesno("Supprimer", f"Supprimer « {nom} » ?"):
            return

        presets = get_presets_pour_utilisateur(config, ut_code)
        presets.pop(nom, None)
        sauvegarder_config(config)
        refresh_preset_combo(select="")
        lbl_status.config(text=f"✓ Paramétrage supprimé : {nom}", fg=GREEN)
        log(f"Paramétrage supprimé pour {ut_code} : {nom}")

