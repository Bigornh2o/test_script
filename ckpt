    def demander_identifiants_ui(message=None, obligatoire=False):
        username_enregistre, _ = charger_identifiants_pour_utilisateur(config, ut_code)

        def enregistrer(username, password):
            sauvegarder_identifiants_pour_utilisateur(config, ut_code, username, password)
            sauvegarder_config(config)

        resultat = modale_identifiants(
            root,
            username_initial=username_enregistre or USERNAME,
            message=message,
            obligatoire=obligatoire,
            enregistrer=enregistrer,
        )
        if resultat is None:
            return False

        appliquer_identifiants(*resultat)
        if lbl_status.winfo_exists():
            lbl_status.configure(text="✓ Identifiants Cockpit enregistrés", text_color=GREEN)
        log(f"Identifiants Cockpit enregistrés pour {ut_code}")
        return True

