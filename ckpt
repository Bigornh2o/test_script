def generer_liste_monthly():
    aujourd_hui = datetime.today()

    annee_debut = aujourd_hui.year - 1
    mois_debut = 1

    if aujourd_hui.month == 1:
        annee_fin = aujourd_hui.year - 1
        mois_fin = 12
    else:
        annee_fin = aujourd_hui.year
        mois_fin = aujourd_hui.month - 1

    resultat = []
    annee = annee_debut
    mois = mois_debut

    while (annee < annee_fin) or (annee == annee_fin and mois <= mois_fin):
        resultat.append(f"{annee}-{mois:02d}")
        mois += 1
        if mois == 13:
            mois = 1
            annee += 1

    return list(reversed(resultat))


