def identifier_ligne(texte, restants):
    texte = (texte or "").casefold()
    for row in restants:
        if nom_attendu(row).casefold() in texte:
            return row
    return None


def cliquer_un_accept(page, restants, output_dir):
    accept_buttons = page.locator("cp-notification").locator(
        "button.btn.pms-btn.validation-btn"
    ).filter(has_text=re.compile(r"^\s*Accept\s*$", re.I))

    for i in range(accept_buttons.count()):
        btn = accept_buttons.nth(i)
        try:
            if not btn.is_visible():
                continue

            try:
                texte_notif = btn.locator("xpath=ancestor::li[1]").first.inner_text()
            except Exception:
                texte_notif = ""

            with page.expect_download(timeout=30000) as download_info:
                btn.evaluate("(el) => el.click()")

            download = download_info.value
            nom_cockpit = download.suggested_filename or f"fichier_{int(time.time() * 1000)}.pdf"

            row = identifier_ligne(f"{nom_cockpit} {texte_notif}", restants)

            if row:
                chemin = chemin_libre(output_dir, f"{nom_attendu(row)}.pdf")
                verification = "OK"
            else:
                chemin = chemin_libre(output_dir, nom_cockpit)
                verification = "NON VERIFIE - fichier non renommé"
                log(f"ATTENTION : fichier '{nom_cockpit}' non reconnu, gardé sous son nom d'origine.")

            download.save_as(chemin)
            page.wait_for_timeout(3000)

            return {
                "N_intv": row["N_intv"] if row else "",
                "Date": row["Date"] if row else "",
                "StatementType": row["StatementType"] if row else "",
                "PerformanceType": row.get("PerformanceType", "") if row else "",
                "Est_currency": row.get("Est_currency", "") if row else "",
                "Language": row.get("Language", "") if row else "",
                "Monthly_perf_history": row.get("Monthly_perf_history", "") if row else "",
                "Annual_perf_history": row.get("Annual_perf_history", "") if row else "",
                "Fichier": chemin,
                "Nom Cockpit": nom_cockpit,
                "Verification": verification,
                "_row": row,
            }

        except Exception as e:
            log(f"Impossible de traiter Accept #{i + 1} : {e}")

    return None


def attendre_et_telecharger_fichiers(page, expected_rows, output_dir,
                                     interval_seconds=INTERVALLE_NOTIFS_SEC,
                                     timeout_minutes=TIMEOUT_NOTIFS_MIN):
    fichiers = []
    restants = list(expected_rows)
    nb_attendus = len(expected_rows)

    if not restants:
        log("Aucune génération réussie, pas de fichier à attendre.")
        return fichiers

    os.makedirs(output_dir, exist_ok=True)
    log(f"Attente de {nb_attendus} fichier(s) dans les notifications...")

    deadline = time.time() + timeout_minutes * 60
    termine = False

    while restants and not termine and time.time() < deadline:
        try:
            ouvrir_panneau_notifications(page)

            while restants:
                info = cliquer_un_accept(page, restants, output_dir)
                if not info:
                    if len(fichiers) >= nb_attendus:
                        termine = True
                    break
                if info["_row"]:
                    restants.remove(info["_row"])
                fichiers.append(info)
                log(f"Fichier {len(fichiers)} ({info['Verification']}) : {info['Fichier']}")

        except Exception as e:
            log(f"ATTENTION : erreur pendant la vérification des notifications : {e}")

        if not restants or termine:
            break

        nb_ok = nb_attendus - len(restants)
        log(f"{nb_ok}/{nb_attendus} fichier(s) vérifié(s), nouvelle vérification dans {interval_seconds}s...")
        fermer_panneau_notifications(page)
        page.wait_for_timeout(interval_seconds * 1000)

    if restants:
        manquants = [nom_attendu(r) for r in restants]
        log(f"ATTENTION : {len(restants)} fichier(s) non retrouvé(s) : {manquants}")
    else:
        log(f"OK : les {nb_attendus} fichier(s) ont été récupérés et vérifiés.")

    return fichiers


# ============================================================
# Traitement principal
# ============================================================
def run(playwright, df, output_dir):
    browser = playwright.chromium.launch(
        executable_path=CHROME_PATH,
        headless=False
    )
    context = browser.new_context(accept_downloads=True)
    page = context.new_page()

    page.set_default_timeout(15000)
    page.set_viewport_size({"width": 1650, "height": 1000})

    resultats = []
    fichiers = []
    rows_to_process = []
    rows_generees = []
    nb_generes = 0

    try:
        connexion(page)

        rows_to_process = lire_lignes_depuis_df(df)
        log(f"{len(rows_to_process)} valeur(s) N_intv à traiter")

        for idx, ligne in enumerate(rows_to_process, start=1):
            n_intv = ligne["N_intv"]
            date_ligne = ligne["Date"]
            statement_type = ligne["StatementType"]
            performance_type = ligne["PerformanceType"]

            log(
                f"===== {idx}/{len(rows_to_process)} : "
                f"{n_intv} / {date_ligne} / {statement_type} / {performance_type} ====="
            )
            try:
                selectionner_n_intv_typeahead(page, n_intv)
                checker_n_intv_grille(page, n_intv)

                cliquer_statements_et_portfolio(page)
                traiter_modal_portfolio(page, ligne)

                nb_generes += 1
                rows_generees.append(ligne)
                resultats.append({
                    "N_intv": n_intv,
                    "Date": date_ligne,
                    "StatementType": statement_type,
                    "PerformanceType": performance_type,
                    "Est_currency": ligne.get("Est_currency", ""),
                    "Language": ligne.get("Language", ""),
                    "Monthly_perf_history": ligne.get("Monthly_perf_history", ""),
                    "Annual_perf_history": ligne.get("Annual_perf_history", ""),
                    "Statut": "OK",
                    "Erreur": ""
                })
            except Exception as e:
                log(f"ERREUR sur {n_intv} : {e}")
                resultats.append({
                    "N_intv": n_intv,
                    "Date": date_ligne,
                    "StatementType": statement_type,
                    "PerformanceType": performance_type,
                    "Est_currency": ligne.get("Est_currency", ""),
                    "Language": ligne.get("Language", ""),
                    "Monthly_perf_history": ligne.get("Monthly_perf_history", ""),
                    "Annual_perf_history": ligne.get("Annual_perf_history", ""),
                    "Statut": "KO",
                    "Erreur": str(e)[:300]
                })
            finally:
                try:
                    cliquer_clear_all_filters(page)
                except Exception as e:
                    log(f"ATTENTION : impossible de cliquer Clear all filters : {e}")

        log(f"{nb_generes}/{len(rows_to_process)} génération(s) soumise(s) avec succès.")
        fichiers = attendre_et_telecharger_fichiers(page, rows_generees, output_dir)
        log("Traitement terminé.")

    finally:
        browser.close()

    return nb_generes


