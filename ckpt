def popup_fin_generation_choix(parent, nb_generes):
    result = {"fermer": False}

    top = ctk.CTkToplevel(parent)
    top.title("Génération terminée")
    top.configure(fg_color=UI_CARD)
    top.resizable(False, False)
    top.transient(parent)

    largeur = 460
    hauteur = 200
    parent.update_idletasks()
    x = parent.winfo_rootx() + max((parent.winfo_width() - largeur) // 2, 0)
    y = parent.winfo_rooty() + max((parent.winfo_height() - hauteur) // 2, 0)
    top.geometry(f"{largeur}x{hauteur}+{x}+{y}")

    frame = ctk.CTkFrame(top, fg_color="transparent")
    frame.pack(fill="both", expand=True, padx=26, pady=22)

    ligne_titre = ctk.CTkFrame(frame, fg_color="transparent")
    ligne_titre.pack(fill="x", anchor="w")

    ctk.CTkLabel(
        ligne_titre, text="✓", text_color=GREEN, font=_police(20, "bold")
    ).pack(side="left")

    ctk.CTkLabel(
        ligne_titre, text="Génération terminée", font=_police(16, "bold"), text_color=UI_TEXT
    ).pack(side="left", padx=(12, 0))

    ctk.CTkLabel(
        frame,
        text=_accorder(
            nb_generes,
            "Aucun reporting n'a été généré.",
            "Le reporting a été généré.",
            "Les {n} reportings ont été générés.",
        ),
        font=_police(13),
        text_color=UI_MUTED,
        anchor="w"
    ).pack(fill="x", pady=(14, 0))

    btns = ctk.CTkFrame(frame, fg_color="transparent")
    btns.pack(side="bottom", fill="x")

    def rester():
        result["fermer"] = False
        top.destroy()

    def fermer():
        result["fermer"] = True
        top.destroy()

    _Bouton(btns, "primaire", text="Fermer", command=fermer, width=110).pack(side="right")
    _Bouton(btns, "secondaire", text="Rester sur cette page", command=rester).pack(side="right", padx=(0, 10))

    top.protocol("WM_DELETE_WINDOW", rester)
    try:
        top.wait_visibility()
        top.grab_set()
        top.lift()
        top.focus_force()
    except Exception:
        pass
    parent.wait_window(top)

    return result["fermer"]


