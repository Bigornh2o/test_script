def migrer_structure_config(data):
    """
    Migre l'ancien format :
      {
        "ut34e9": "P:/mon/output"
      }
    vers le nouveau format :
      {
        "ut34e9": {
          "output_path": "P:/mon/output",
          "presets": {},
          "last_params": {}
        }
      }
    """
    if not isinstance(data, dict):
        return {}

    nouveau = {}
    for cle, val in data.items():
        if isinstance(val, str):
            nouveau[cle] = {
                "output_path": val,
                "presets": {},
                "last_params": {}
            }
        elif isinstance(val, dict):
            output_path = val.get("output_path", "")
            presets = val.get("presets", {})
            last_params = val.get("last_params", {})

            if not isinstance(presets, dict):
                presets = {}

            if not isinstance(last_params, dict):
                last_params = {}

            if not output_path:
                for k_alt in ["output", "output_dir", "path"]:
                    if isinstance(val.get(k_alt), str):
                        output_path = val.get(k_alt)
                        break

            nouveau[cle] = {
                "output_path": str(output_path or "").strip(),
                "presets": presets,
                "last_params": last_params
            }
        else:
            nouveau[cle] = {
                "output_path": "",
                "presets": {},
                "last_params": {}
            }

    return nouveau


def charger_config():
    if not os.path.exists(CONFIG_JSON_PATH):
        return {}

    try:
        with open(CONFIG_JSON_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)

        data = migrer_structure_config(data)
        return data if isinstance(data, dict) else {}
    except Exception as e:
        log(f"ATTENTION : lecture JSON impossible ({e}), démarrage avec config vide.")
        return {}


def sauvegarder_config(config):
    dossier = os.path.dirname(CONFIG_JSON_PATH)
    if dossier:
        os.makedirs(dossier, exist_ok=True)

    fd, temp_path = tempfile.mkstemp(prefix="cfg_", suffix=".json", dir=dossier or None)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(config, f, indent=2, ensure_ascii=False)
        os.replace(temp_path, CONFIG_JSON_PATH)
    except Exception:
        try:
            if os.path.exists(temp_path):
                os.remove(temp_path)
        except Exception:
            pass
        raise


def get_user_cfg(config, ut_code):
