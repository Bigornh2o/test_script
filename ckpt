def clean_n_intv(value):
    if pd.isna(value):
        return None
    value = str(value).strip()
    if value.endswith(".0"):
        value = value[:-2]
    if not value:
        return None
    digits = re.sub(r"\D", "", value)
    if not digits:
        return None
    return digits.zfill(7)


def normaliser_date(value):
    if pd.isna(value):
        return None

    if isinstance(value, (datetime, pd.Timestamp)):
        return value.strftime("%d.%m.%Y")

    texte = str(value).strip()
    if not texte:
        return None

    for fmt in ("%d.%m.%Y", "%d/%m/%Y", "%Y-%m-%d", "%d%m%Y"):
        try:
            dt = datetime.strptime(texte, fmt)
            return dt.strftime("%d.%m.%Y")
        except ValueError:
            pass

    dt = pd.to_datetime(texte, dayfirst=True, errors="coerce")
    if pd.isna(dt):
        raise ValueError(f"Date invalide : {value}")

    return dt.strftime("%d.%m.%Y")


def normaliser_statement_type(value):
    if pd.isna(value):
        raise ValueError("La colonne du type de statement est vide.")

    txt = str(value).strip().lower()

    mapping = {
        "standard": "Standard",
        "std": "Standard",
        "full": "Full",
        "light": "Light",
    }

    if txt not in mapping:
        raise ValueError(
            f"Valeur de statement type invalide : {value}. "
            f"Valeurs attendues : Standard, Full, Light."
        )

    return mapping[txt]


def normaliser_texte(value, default=""):
    if pd.isna(value):
        return default
    txt = str(value).strip()
    return txt if txt else default


def to_bool(value):
    if pd.isna(value):
        return False
    if isinstance(value, bool):
        return value
    txt = str(value).strip().lower()
    return txt in ("1", "true", "yes", "oui", "x", "vrai")


def texte_normalise(value):
    return str(value or "").strip().upper()


def valeurs_egales(a, b):
    return texte_normalise(a) == texte_normalise(b)


def bool_egal(a, b):
    return bool(a) == bool(b)


