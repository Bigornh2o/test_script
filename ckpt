def selectionner_n_intv_typeahead(page, n_intv):
    champ = attendre_champ_relation_actif(page)

    log(f"Saisie de {n_intv} dans Relationship number...")
    champ.click()
    champ.fill(n_intv)
    champ.press("Enter")

    popup = page.locator("ngb-typeahead-window").first
    popup.wait_for(state="visible", timeout=15000)

    options = popup.locator('button[role="option"]')
    cible = None
    deadline = time.time() + 10

    while time.time() < deadline and cible is None:
        try:
            count = options.count()
        except Exception:
            count = 0

        for i in range(count):
            opt = options.nth(i)
            try:
                if contient_n_intv(opt.inner_text(), n_intv):
                    cible = opt
                    break
            except Exception:
                pass

        if cible is None:
            page.wait_for_timeout(250)

    if cible is None:
        try:
            suggestions = [t.strip() for t in options.all_inner_texts()]
        except Exception:
            suggestions = []
        raise RuntimeError(
            f"Aucune suggestion correspondant à {n_intv} trouvée. "
            f"Suggestions visibles : {suggestions}"
        )

    cible.click(force=True)
    log(f"Suggestion {n_intv} cliquée.")


def checker_n_intv_grille(page, n_intv, timeout=30000):
    cellules = page.locator(f"{SEL_ROWS} {SEL_CELL_RELATION}")
    deadline = time.time() + timeout / 1000
    textes = []

    while time.time() < deadline:
        try:
            textes = [t.strip() for t in cellules.all_inner_texts() if t.strip()]
        except Exception:
            textes = []

        if textes and all(contient_n_intv(t, n_intv) for t in textes):
            log(f"Check OK ({len(textes)} ligne(s)) : {textes[0].replace(chr(10), ' | ')}")
            return

        page.wait_for_timeout(250)

    apercu = [t.replace("\n", " | ") for t in textes[:3]]
    raise RuntimeError(
        f"Check KO : la grille n'est pas filtrée sur {n_intv} "
        f"({len(textes)} ligne(s), ex. : {apercu})"
    )


