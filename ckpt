def lire_valeur_input(page, selector):
    try:
        champ = page.locator(selector).first
        champ.wait_for(state="visible", timeout=5000)
        return champ.input_value().strip()
    except Exception:
        return ""


def lire_valeur_ng_select(page, formcontrolname):
    base = page.locator(f'[formcontrolname="{formcontrolname}"]').first
    try:
        base.wait_for(state="visible", timeout=5000)
    except Exception:
        return ""

    selectors = [
        ".ng-value-label",
        ".ng-single-label",
        ".ng-value",
        ".ng-input input",
        "input",
        ".ng-placeholder",
    ]

    for sel in selectors:
        try:
            loc = base.locator(sel).first
            if loc.count() == 0:
                continue

            tag = ""
            try:
                tag = loc.evaluate("(el) => el.tagName")
            except Exception:
                pass

            if str(tag).upper() == "INPUT":
                val = loc.input_value().strip()
            else:
                val = (loc.inner_text() or "").strip()

            if val:
                return val
        except Exception:
            pass

    try:
        txt = (base.inner_text() or "").strip()
        return txt
    except Exception:
        return ""


def remplir_ng_select_si_necessaire(page, formcontrolname, value, libelle=None):
    actuel = lire_valeur_ng_select(page, formcontrolname)
    attendu = str(value).strip()

    if valeurs_egales(actuel, attendu):
        log(f"{libelle or formcontrolname} déjà correct : {attendu}")
        return

    log(f"Mise à jour {libelle or formcontrolname} : '{actuel}' -> '{attendu}'")

    champ = page.locator(f'[formcontrolname="{formcontrolname}"]').first
    champ.wait_for(state="visible", timeout=15000)
    champ.scroll_into_view_if_needed()
    champ.click()

    input_interne = champ.locator("input").first
    input_interne.wait_for(state="visible", timeout=5000)
    input_interne.fill("")
    input_interne.type(attendu, delay=50)
    input_interne.press("Enter")


def regler_checkbox(page, formcontrolname, cocher):
    cb = page.locator(f'input[formcontrolname="{formcontrolname}"]').first
    cb.wait_for(state="visible", timeout=15000)

    if cocher:
        if not cb.is_checked():
            cb.check(force=True)
    else:
        if cb.is_checked():
            cb.uncheck(force=True)


def lire_checkbox(page, formcontrolname):
    try:
        cb = page.locator(f'input[formcontrolname="{formcontrolname}"]').first
        cb.wait_for(state="visible", timeout=5000)
        return cb.is_checked()
    except Exception:
        return False


def clear_et_saisir_date_si_necessaire(page, date_value):
