    def charger_fichier():
        chemin = filedialog.askopenfilename(
            title="Choisir un fichier Excel",
            filetypes=[("Fichiers Excel", "*.xlsx *.xls")]
        )
        if not chemin:
            return

        try:
            liste = charger_n_intv_depuis_xlsx(chemin)
            if not liste:
                messagebox.showwarning("Fichier vide", "Aucun Numéro d'intervenant exploitable n'a été trouvé dans le fichier.")
