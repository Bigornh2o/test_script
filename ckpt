        txt_n_intv.delete("1.0", "end")
        txt_n_intv.insert("1.0", "\n".join(preset.get("n_intv", [])))

        params = preset.get("params", {})

        selected_statement["value"] = str(
            params.get("statement_type", DEFAULT_GUI_VALUES["Statement_type"])
        ).strip().upper() or DEFAULT_GUI_VALUES["Statement_type"]
        refresh_statement_buttons()

        var_currency.set(str(params.get("currency", DEFAULT_GUI_VALUES["Est_currency"])).strip() or DEFAULT_GUI_VALUES["Est_currency"])
        var_lang.set(str(params.get("language", DEFAULT_GUI_VALUES["Language"])).strip() or DEFAULT_GUI_VALUES["Language"])
        var_anonymized.set(bool(params.get("anonymized", DEFAULT_GUI_VALUES["Anonymized_document"])))
        var_signature.set(bool(params.get("signature", DEFAULT_GUI_VALUES["Client_signature"])))
        var_perf.set(str(params.get("performance_type", DEFAULT_GUI_VALUES["Performance_type"])).strip() or DEFAULT_GUI_VALUES["Performance_type"])
        var_monthly.set(str(params.get("monthly_perf_history", DEFAULT_GUI_VALUES["Monthly_perf_history"])).strip() or DEFAULT_GUI_VALUES["Monthly_perf_history"])
        var_annual.set(str(params.get("annual_perf_history", DEFAULT_GUI_VALUES["Annual_perf_history"])).strip() or DEFAULT_GUI_VALUES["Annual_perf_history"])

        output_path_preset = str(params.get("output_path", "")).strip()
        if output_path_preset:
            if os.path.isdir(output_path_preset):
                var_output_dir.set(output_path_preset)
            else:
                messagebox.showwarning(
                    "Répertoire introuvable",
                    f"Le répertoire du paramétrage n'existe plus :\n{output_path_preset}\n\nLe répertoire output actuel est conservé."
