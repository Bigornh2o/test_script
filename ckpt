        "Language": lire_valeur_ng_select(page, "language"),
        "Monthly_perf_history": lire_valeur_ng_select(page, "monthlyPerformanceFrom"),
        "Annual_perf_history": lire_valeur_ng_select(page, "annualPerformanceFrom"),
        "Anonymized_document": lire_checkbox(page, "anonymizedDocument"),
        "Client_signature": lire_checkbox(page, "bienTrouve"),
        "FileName": lire_file_name(page),
        "FileNameAttendu": file_name_attendu(ligne["N_intv"], ligne["StatementType"]),
    }


def comparer_parametres_modale(page, ligne):
    lus = lire_parametres_modale(page, ligne)

    attendu_date = normaliser_date(ligne["Date"])
    try:
        lu_date = normaliser_date(lus["Date"]) if lus["Date"] else ""
    except Exception:
        lu_date = lus["Date"]

    ecarts = []

    if not valeurs_egales(lus["StatementType"], ligne["StatementType"]):
        ecarts.append(f"StatementType: lu='{lus['StatementType']}' attendu='{ligne['StatementType']}'")

    if lu_date != attendu_date:
        ecarts.append(f"Date: lue='{lus['Date']}' attendue='{attendu_date}'")

    if not valeurs_egales(lus["PerformanceType"], ligne["PerformanceType"]):
        ecarts.append(f"PerformanceType: lu='{lus['PerformanceType']}' attendu='{ligne['PerformanceType']}'")

    if not valeurs_egales(lus["Est_currency"], ligne["Est_currency"]):
        ecarts.append(f"Est_currency: lu='{lus['Est_currency']}' attendu='{ligne['Est_currency']}'")

    if not valeurs_egales(lus["Language"], ligne["Language"]):
        ecarts.append(f"Language: lu='{lus['Language']}' attendu='{ligne['Language']}'")

    if not valeurs_egales(lus["Monthly_perf_history"], ligne["Monthly_perf_history"]):
        ecarts.append(f"Monthly_perf_history: lu='{lus['Monthly_perf_history']}' attendu='{ligne['Monthly_perf_history']}'")

    if not valeurs_egales(lus["Annual_perf_history"], ligne["Annual_perf_history"]):
        ecarts.append(f"Annual_perf_history: lu='{lus['Annual_perf_history']}' attendu='{ligne['Annual_perf_history']}'")

    if not bool_egal(lus["Anonymized_document"], ligne["Anonymized_document"]):
        ecarts.append(f"Anonymized_document: lu='{lus['Anonymized_document']}' attendu='{ligne['Anonymized_document']}'")

    if not bool_egal(lus["Client_signature"], ligne["Client_signature"]):
        ecarts.append(f"Client_signature: lu='{lus['Client_signature']}' attendu='{ligne['Client_signature']}'")

    if lus["FileName"] != lus["FileNameAttendu"]:
        ecarts.append(f"FileName: lu='{lus['FileName']}' attendu='{lus['FileNameAttendu']}'")

    return ecarts, lus


def verifier_et_corriger_parametres_avant_generate(page, ligne):
    log("Vérification finale des paramètres avant Generate...")

    # 1er contrôle
    ecarts, valeurs_lues = comparer_parametres_modale(page, ligne)

    if ecarts:
        log("Écarts détectés avant Generate :")
        for e in ecarts:
            log(f" - {e}")

        cliquer_statement_type(page, ligne["StatementType"])
        clear_et_saisir_date_si_necessaire(page, ligne["Date"])
        saisir_performance_type_si_necessaire(page, ligne["PerformanceType"])
        remplir_ng_select_si_necessaire(page, "estimationCurrency", ligne["Est_currency"], "Estimation currency")
        remplir_ng_select_si_necessaire(page, "language", ligne["Language"], "Language")
        remplir_ng_select_si_necessaire(page, "monthlyPerformanceFrom", ligne["Monthly_perf_history"], "Monthly performance history")
        remplir_ng_select_si_necessaire(page, "annualPerformanceFrom", ligne["Annual_perf_history"], "Annual performance history")
        regler_checkbox(page, "anonymizedDocument", ligne["Anonymized_document"])
        regler_checkbox(page, "bienTrouve", ligne["Client_signature"])
        remplir_file_name_si_necessaire(page, ligne["N_intv"], ligne["StatementType"])

        page.wait_for_timeout(500)

    # 2e contrôle de confirmation
    ecarts_finaux, valeurs_finales = comparer_parametres_modale(page, ligne)

    if ecarts_finaux:
        detail = " ; ".join(ecarts_finaux)
        raise RuntimeError(f"Contrôle final KO avant Generate : {detail}")

    log("Contrôle final OK : tous les paramètres sont conformes.")


