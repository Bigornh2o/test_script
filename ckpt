def get_ut_code():
    """
    Essaie de récupérer le code UT Windows.
    Exemple attendu : ut34e9
    """
    candidats = []

    try:
        candidats.append(os.getlogin())
    except Exception:
        pass

    for var in ["USERNAME", "USER", "LOGNAME"]:
        val = os.environ.get(var)
        if val:
            candidats.append(val)

    try:
        home_name = Path.home().name
        if home_name:
            candidats.append(home_name)
    except Exception:
        pass

    for val in candidats:
        val = str(val).strip()
        if re.fullmatch(r"ut[a-zA-Z0-9]+", val, flags=re.IGNORECASE):
            return val.lower()

    for val in candidats:
        val = str(val).strip()
        if val:
            return val.lower()

    return "unknown_user"


def log(message):
    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {message}")


def migrer_structure_config(data):
    """
    Migre l'ancien format :
      {
        "ut34e9": "P:/mon/output"
      }
    vers le nouveau format :
      {
        "ut34e9": {
          "output_path": "P:/mon/output",
          "presets": {},
          "last_params": {}
        }
      }
    """
    if not isinstance(data, dict):
        return {}

    nouveau = {}
    for cle, val in data.items():
        if isinstance(val, str):
            nouveau[cle] = {
                "output_path": val,
                "presets": {},
                "last_params": {}
            }
        elif isinstance(val, dict):
            output_path = val.get("output_path", "")
            presets = val.get("presets", {})
            last_params = val.get("last_params", {})

            if not isinstance(presets, dict):
                presets = {}

            if not isinstance(last_params, dict):
                last_params = {}

            if not output_path:
                for k_alt in ["output", "output_dir", "path"]:
                    if isinstance(val.get(k_alt), str):
                        output_path = val.get(k_alt)
                        break

            nouveau[cle] = {
                "output_path": str(output_path or "").strip(),
                "presets": presets,
                "last_params": last_params
            }

            if isinstance(val.get("identifiants"), dict):
                nouveau[cle]["identifiants"] = val["identifiants"]
        else:
            nouveau[cle] = {
                "output_path": "",
                "presets": {},
                "last_params": {}
            }

    return nouveau


def charger_config():
    if not os.path.exists(CONFIG_JSON_PATH):
        return {}

    try:
        with open(CONFIG_JSON_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)

        data = migrer_structure_config(data)
        return data if isinstance(data, dict) else {}
    except Exception as e:
        log(f"ATTENTION : lecture JSON impossible ({e}), démarrage avec config vide.")
        return {}


def sauvegarder_config(config):
    dossier = os.path.dirname(CONFIG_JSON_PATH)
    if dossier:
        os.makedirs(dossier, exist_ok=True)

    fd, temp_path = tempfile.mkstemp(prefix="cfg_", suffix=".json", dir=dossier or None)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(config, f, indent=2, ensure_ascii=False)
        os.replace(temp_path, CONFIG_JSON_PATH)
    except Exception:
        try:
            if os.path.exists(temp_path):
                os.remove(temp_path)
        except Exception:
            pass
        raise


def get_user_cfg(config, ut_code):
    bloc = config.setdefault(ut_code, {})
    if not isinstance(bloc, dict):
        bloc = {}
        config[ut_code] = bloc

    if "output_path" not in bloc or not isinstance(bloc.get("output_path"), str):
        bloc["output_path"] = ""

    if "presets" not in bloc or not isinstance(bloc.get("presets"), dict):
        bloc["presets"] = {}

    if "last_params" not in bloc or not isinstance(bloc.get("last_params"), dict):
        bloc["last_params"] = {}

    return bloc


