    def generer():
        nonlocal df_courant
        if not data_validee:
            messagebox.showwarning("Validation requise", "Merci de cliquer d'abord sur VALIDER.")
            return

        try:
            df_courant = construire_df_depuis_ui()
            chemin_output = var_output_dir.get().strip()

            if not os.path.isdir(chemin_output):
                raise ValueError("Le répertoire output n'est plus accessible.")

            sauvegarder_output_dir_pour_utilisateur(config, ut_code, chemin_output)

            payload = get_params_preset()
            sauvegarder_last_params_pour_utilisateur(config, ut_code, payload)

            sauvegarder_config(config)

        except Exception as e:
            messagebox.showerror("Erreur", f"Préparation impossible : {e}")
            return

        desactiver_boutons_traitement()
        afficher_traitement()
        root.update_idletasks()
        root.update()

        try:
            with sync_playwright() as playwright:
                nb = run(playwright, df_courant, chemin_output)

            masquer_traitement()

