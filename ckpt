def attendre_champ_relation_actif(page, timeout=TIMEOUT_CHAMP_MS):
    champ = page.locator(SEL_CHAMP_RELATION).first
    champ.wait_for(state="visible", timeout=timeout)

    debut = time.time()
    page.wait_for_function(
        "(sel) => { const el = document.querySelector(sel); return !!el && !el.disabled; }",
        arg=SEL_CHAMP_RELATION,
        timeout=timeout
    )
    attente = time.time() - debut
    if attente > 1:
        log(f"Champ Relationship number actif après {attente:.1f}s (chargement de la grille)")

    return champ


def connexion(page):
    log("Accès à la page de login...")
    page.goto(URL_LOGIN, wait_until="domcontentloaded")

    page.wait_for_selector(SEL_USERNAME, state="visible", timeout=15000)
    page.locator(SEL_USERNAME).fill(USERNAME)

    page.wait_for_selector(SEL_PASSWORD, state="visible", timeout=15000)
    page.locator(SEL_PASSWORD).fill(PASSWORD)

    page.locator(SEL_SUBMIT).click()

    # Identifiants refusés : la page de login reste affichée au lieu de charger Cockpit
    debut = time.time()
    while not page.locator(SEL_CHAMP_RELATION).first.is_visible():
        ecoule = time.time() - debut
        if ecoule > DELAI_ECHEC_LOGIN_SEC and page.locator(SEL_PASSWORD).first.is_visible():
            raise EchecConnexionCockpit("Cockpit a refusé l'identifiant ou le mot de passe.")
        if ecoule > TIMEOUT_CHAMP_MS / 1000:
            break
        page.wait_for_timeout(500)

    attendre_champ_relation_actif(page)
    log("Connexion réussie.")


