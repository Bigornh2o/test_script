def _icone_oeil(barre=False, couleur=UI_MUTED, fond=UI_FIELD, taille=20):
    """Icône œil (ou œil barré) dessinée avec Pillow, nette quel que soit l'écran."""
    from PIL import Image, ImageDraw

    f = 6
    s = taille * f
    img = Image.new("RGBA", (s, s), (0, 0, 0, 0))
    d = ImageDraw.Draw(img)
    epaisseur = max(f, int(s * 0.085))

    d.ellipse((int(s * 0.06), int(s * 0.24), int(s * 0.94), int(s * 0.76)), outline=couleur, width=epaisseur)
    r = int(s * 0.13)
    d.ellipse((s // 2 - r, s // 2 - r, s // 2 + r, s // 2 + r), fill=couleur)

    if barre:
        d.line((int(s * 0.16), int(s * 0.86), int(s * 0.84), int(s * 0.14)), fill=fond, width=epaisseur * 3)
        d.line((int(s * 0.16), int(s * 0.86), int(s * 0.84), int(s * 0.14)), fill=couleur, width=epaisseur)

    img = img.resize((taille * 2, taille * 2), Image.LANCZOS)
    return ctk.CTkImage(light_image=img, size=(taille, taille))


def modale_identifiants(root, username_initial="", message=None, obligatoire=False, enregistrer=None):
    """
    Affiche une carte de connexion par-dessus la fenêtre principale floutée.
    - obligatoire=True : pas de bouton Annuler, fermer la fenêtre quitte le robot.
    - enregistrer(username, password) : appelé à la validation ; une exception
      s'affiche dans la carte et la modale reste ouverte.
    Retourne (username, password) ou None si annulé.
    """
    resultat = {"valeur": None, "quitter": False}
    termine = tk.BooleanVar(master=root, value=False)

    root.update_idletasks()
    root.update()

    # ---- Fond : capture de la fenêtre, floutée -----------------
    largeur = max(root.winfo_width(), 1)
    hauteur = max(root.winfo_height(), 1)
    try:
        echelle = ctk.ScalingTracker.get_widget_scaling(root)
    except Exception:
        echelle = 1.0

    image_fond = None
    couleur_coins = UI_BG
    try:
        from PIL import Image, ImageFilter, ImageGrab

        x, y = root.winfo_rootx(), root.winfo_rooty()
        capture = ImageGrab.grab(bbox=(x, y, x + largeur, y + hauteur), all_screens=True).convert("RGB")
        capture = capture.filter(ImageFilter.GaussianBlur(radius=12))
        capture = Image.blend(capture, Image.new("RGB", capture.size, "#0F1B33"), 0.30)

        cx, cy = capture.size[0] // 2, capture.size[1] // 2
        r, g, b = capture.crop((cx - 260, cy - 200, cx + 260, cy + 200)).resize((1, 1)).getpixel((0, 0))
        couleur_coins = f"#{r:02x}{g:02x}{b:02x}"

        image_fond = ctk.CTkImage(light_image=capture, size=(largeur / echelle, hauteur / echelle))
    except Exception as e:
        log(f"Flou d'arrière-plan indisponible ({e}), fond uni utilisé.")
        couleur_coins = "#8C95A6"

    calque = ctk.CTkLabel(root, text="", image=image_fond, fg_color=couleur_coins, corner_radius=0)
    calque.place(x=0, y=0, relwidth=1, relheight=1)
    calque.lift()

    # ---- Carte de connexion ------------------------------------
    carte = ctk.CTkFrame(
        root, fg_color=UI_CARD, bg_color=couleur_coins, corner_radius=12,
        border_width=1, border_color=UI_BORDER
    )
    carte.place(relx=0.5, rely=0.5, anchor="center")
    carte.lift()

    contenu = ctk.CTkFrame(carte, fg_color="transparent")
    contenu.pack(padx=44, pady=(36, 34))

    ctk.CTkLabel(contenu, text="Connexion à Cockpit", font=_police(24, "bold"), text_color=UI_TEXT).pack()

    ctk.CTkLabel(
        contenu,
        text="Tes identifiants sont enregistrés chiffrés sur ce poste.\nTu pourras les modifier à tout moment.",
        font=_police(12),
        text_color=UI_MUTED,
        justify="center",
    ).pack(pady=(6, 24))

    if message:
        ctk.CTkLabel(
            contenu,
            text=message,
            font=_police(12, "bold"),
            text_color=RED,
            fg_color="#FDECEA",
            corner_radius=8,
            wraplength=380,
            justify="left",
        ).pack(fill="x", pady=(0, 16), ipadx=10, ipady=8)

    style_champ = dict(
        width=400, height=46, corner_radius=8, border_width=1, border_color="#CBD3DF",
        fg_color=UI_CARD, text_color=UI_TEXT, placeholder_text_color="#8A93A3", font=_police(14),
    )

    e_user = ctk.CTkEntry(contenu, placeholder_text="Username", **style_champ)
    e_user.pack(pady=(0, 14))
    if username_initial:
        e_user.insert(0, username_initial)

    e_pwd = ctk.CTkEntry(contenu, placeholder_text="Password", show="•", **style_champ)
    e_pwd.pack()

    icones = {
        "voir": _icone_oeil(barre=False, couleur=UI_TEXT, fond=UI_CARD),
        "masquer": _icone_oeil(barre=True, couleur=UI_TEXT, fond=UI_CARD),
    }
    etat_mdp = {"visible": False}

    def basculer_visibilite():
        etat_mdp["visible"] = not etat_mdp["visible"]
        e_pwd.configure(show="" if etat_mdp["visible"] else "•")
        btn_oeil.configure(image=icones["masquer" if etat_mdp["visible"] else "voir"])
        e_pwd.focus_set()

    btn_oeil = ctk.CTkButton(
        contenu, text="", image=icones["voir"], width=34, height=34, corner_radius=6,
        fg_color=UI_CARD, hover_color=UI_HOVER_LIGHT, command=basculer_visibilite, cursor="hand2"
    )
    btn_oeil.place(in_=e_pwd, relx=1.0, x=-6, rely=0.5, anchor="e")

    lbl_erreur = ctk.CTkLabel(contenu, text="", font=_police(12), text_color=RED, wraplength=400, justify="left")
    lbl_erreur.pack(fill="x", pady=(8, 0))

    boutons = ctk.CTkFrame(contenu, fg_color="transparent")
    boutons.pack(fill="x", pady=(10, 0))

    def valider(*_):
        username = e_user.get().strip()
        password = e_pwd.get()
        if not username or not password:
            lbl_erreur.configure(text="Merci de renseigner l'identifiant et le mot de passe.")
            return
        if enregistrer is not None:
            try:
                enregistrer(username, password)
            except Exception as e:
                lbl_erreur.configure(text=f"Enregistrement impossible : {e}")
                return
        resultat["valeur"] = (username, password)
        termine.set(True)

    def annuler(*_):
        if obligatoire:
            return
        termine.set(True)

    _Bouton(
        boutons, "primaire", text="Enregistrer", command=valider,
        width=130, height=42, font=_police(14, "bold")
    ).pack(side="right")

    if not obligatoire:
        _Bouton(boutons, "secondaire", text="Annuler", command=annuler, width=110, height=42).pack(side="right", padx=(0, 10))

    for champ in (e_user, e_pwd):
        champ.bind("<Return>", valider)
        champ.bind("<Escape>", annuler)
        champ.bind("<Key>", lambda event: lbl_erreur.configure(text="") if event.keysym != "Return" else None)

    # ---- Blocage du reste de la fenêtre pendant la saisie ------
    # tk.Tk.resizable et non root.resizable : la version CustomTkinter masque
    # brièvement la fenêtre sous Windows (clignotement)
    redimensionnable = tk.Tk.resizable(root)
    tk.Tk.resizable(root, False, False)
    ancien_protocole = root.protocol("WM_DELETE_WINDOW")

    def fermeture_fenetre():
        if obligatoire:
            resultat["quitter"] = True
        termine.set(True)

    root.protocol("WM_DELETE_WINDOW", fermeture_fenetre)

    try:
        carte.grab_set()
    except Exception:
        pass
    (e_pwd if username_initial else e_user).focus_set()

    root.wait_variable(termine)

    try:
        carte.grab_release()
    except Exception:
        pass
    carte.destroy()
    calque.destroy()
    tk.Tk.resizable(root, *redimensionnable)
    root.protocol("WM_DELETE_WINDOW", ancien_protocole or root.destroy)

    if resultat["quitter"]:
        root.destroy()
        return None

    return resultat["valeur"]


