def nom_attendu(row):
    date_stamp = time.strftime("%d%m%Y")
    return f"{row['N_intv']}_{date_stamp}_Portfolio_Statement_{row['StatementType']}"


def chemin_libre(output_dir, filename):
    target_path = os.path.join(output_dir, filename)
    base, ext = os.path.splitext(filename)
    i = 1
    while os.path.exists(target_path):
        target_path = os.path.join(output_dir, f"{base}_{i}{ext}")
        i += 1
    return target_path


