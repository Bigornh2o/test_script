def ouvrir_interface():
    ut_code = get_ut_code()
    config = charger_config()
    output_dir_initial = charger_output_dir_pour_utilisateur(config, ut_code)

    data_validee = False
    df_courant = pd.DataFrame(columns=GUI_COLUMNS)

    ctk.set_appearance_mode("light")
    ctk.set_default_color_theme("blue")

    root = ctk.CTk()
    root.title("Cockpit - Paramètres de génération")
    root.configure(fg_color=UI_BG)
    root.geometry("1160x1020")
    root.minsize(1080, 900)

    def _maximiser():
        try:
            root.state("zoomed")
        except Exception:
            pass

    root.after(0, _maximiser)

    style = ttk.Style(root)
    try:
        style.theme_use("clam")
    except Exception:
        pass

    # Style du sélecteur de date (tkcalendar est un widget ttk)
    style.configure(
        "Cockpit.DateEntry",
        fieldbackground=UI_FIELD,
        background=UI_FIELD,
        foreground=UI_TEXT,
        bordercolor=UI_FIELD,
        lightcolor=UI_FIELD,
        darkcolor=UI_FIELD,
        arrowcolor=UI_MUTED,
        arrowsize=14,
        padding=(10, 5),
        relief="flat",
    )
    style.map("Cockpit.DateEntry", fieldbackground=[("readonly", UI_FIELD)])

    var_perf = tk.StringVar(value=DEFAULT_GUI_VALUES["Performance_type"])
    var_currency = tk.StringVar(value=DEFAULT_GUI_VALUES["Est_currency"])
    var_lang = tk.StringVar(value=DEFAULT_GUI_VALUES["Language"])
    var_monthly = tk.StringVar(value=DEFAULT_GUI_VALUES["Monthly_perf_history"])
    var_annual = tk.StringVar(value=DEFAULT_GUI_VALUES["Annual_perf_history"])
    var_anonymized = tk.BooleanVar(value=DEFAULT_GUI_VALUES["Anonymized_document"])
    var_signature = tk.BooleanVar(value=DEFAULT_GUI_VALUES["Client_signature"])
    var_output_dir = tk.StringVar(value=output_dir_initial)
    var_preset = tk.StringVar(value="")

    selected_statement = {"value": DEFAULT_GUI_VALUES["Statement_type"]}

    lbl_status = None
    btn_generate = None
    btn_valider = None
    btn_last_params = None
    btn_save_preset = None
    btn_delete_preset = None
    btn_reset = None
    cb_preset = None
    date_entry = None
    lbl_processing = None
    progress_bar = None
    txt_n_intv = None
    info_var = tk.StringVar(value="Aucun numéro d'intervenant détecté")
    lbl_intro = None
    lbl_output_state = None
    seg_statement = None

    dernier_etat_reference = {"value": None}
    preset_precedent = {"value": ""}

    def get_liste_n_intv():
        contenu = txt_n_intv.get("1.0", "end")
        return extraire_n_intv_depuis_texte(contenu)

    def rafraichir_info_output():
        chemin = var_output_dir.get().strip()
        if not chemin:
            lbl_output_state.configure(
                text="Aucun répertoire output sélectionné",
                text_color=RED
            )
            return

        if os.path.isdir(chemin):
            lbl_output_state.configure(
                text=f"Répertoire output : {chemin}",
                text_color=GREEN
            )
        else:
            lbl_output_state.configure(
                text=f"Répertoire output invalide ou inaccessible : {chemin}",
                text_color=RED
            )

    def mettre_a_jour_compteur(*_):
        liste = get_liste_n_intv()
        info_var.set(_accorder(
            len(liste),
            "Aucun numéro d'intervenant détecté",
            "1 numéro d'intervenant détecté",
            "{n} numéros d'intervenant détectés",
        ))
        if lbl_intro is not None:
            lbl_intro.configure(text=_accorder(
                len(liste),
                "Aucun numéro d'intervenant à traiter pour l'instant.",
                "1 numéro d'intervenant sera traité. Les paramètres ci-dessous lui seront appliqués.",
                "{n} numéros d'intervenant seront traités. Les paramètres ci-dessous seront appliqués à tous.",
            ))

    def normalize_preset_payload(payload):
        n_intv = payload.get("n_intv", [])
        if not isinstance(n_intv, list):
            n_intv = []

        n_intv_norm = []
        vus = set()
        for n in n_intv:
            nn = clean_n_intv(n)
            if nn and nn not in vus:
                vus.add(nn)
                n_intv_norm.append(nn)

        p = payload.get("params", {})
        if not isinstance(p, dict):
            p = {}

        return {
            "n_intv": n_intv_norm,
            "params": {
                "statement_type": str(p.get("statement_type", DEFAULT_GUI_VALUES["Statement_type"])).strip().upper(),
                "currency": str(p.get("currency", DEFAULT_GUI_VALUES["Est_currency"])).strip(),
                "language": str(p.get("language", DEFAULT_GUI_VALUES["Language"])).strip(),
                "anonymized": bool(p.get("anonymized", DEFAULT_GUI_VALUES["Anonymized_document"])),
                "signature": bool(p.get("signature", DEFAULT_GUI_VALUES["Client_signature"])),
                "performance_type": str(p.get("performance_type", DEFAULT_GUI_VALUES["Performance_type"])).strip(),
                "monthly_perf_history": str(p.get("monthly_perf_history", DEFAULT_GUI_VALUES["Monthly_perf_history"])).strip(),
                "annual_perf_history": str(p.get("annual_perf_history", DEFAULT_GUI_VALUES["Annual_perf_history"])).strip(),
                "output_path": str(p.get("output_path", "")).strip(),
            }
        }

    def get_params_preset():
        payload = {
            "n_intv": get_liste_n_intv(),
            "params": {
                "statement_type": selected_statement["value"].strip().upper(),
                "currency": var_currency.get().strip(),
                "language": var_lang.get().strip(),
                "anonymized": bool(var_anonymized.get()),
                "signature": bool(var_signature.get()),
                "performance_type": var_perf.get().strip(),
                "monthly_perf_history": var_monthly.get().strip(),
                "annual_perf_history": var_annual.get().strip(),
                "output_path": var_output_dir.get().strip(),
            }
        }
        return normalize_preset_payload(payload)

    def sauvegarder_derniers_parametres():
        payload = get_params_preset()
        sauvegarder_last_params_pour_utilisateur(config, ut_code, payload)
        sauvegarder_config(config)
        log(f"Derniers paramètres sauvegardés pour {ut_code}")

    def set_reference_state():
        dernier_etat_reference["value"] = get_params_preset()

    def formulaire_modifie_depuis_reference():
        ref = dernier_etat_reference["value"]
        if ref is None:
            return False
        return get_params_preset() != ref

    def mark_dirty(*_):
        nonlocal data_validee
        data_validee = False
        if lbl_status is not None:
            lbl_status.configure(text="", text_color=GREEN)
        if btn_generate is not None:
            btn_generate.configure(state="disabled")
        rafraichir_info_output()

    def on_n_intv_change(event=None):
        mettre_a_jour_compteur()
        mark_dirty()

    def set_statement(name):
        selected_statement["value"] = name
        refresh_statement_buttons()
        mark_dirty()

    def refresh_statement_buttons():
        seg_statement.set(selected_statement["value"])
        # texte blanc sur l'onglet sélectionné, foncé sur les autres
        for nom, bouton in seg_statement._buttons_dict.items():
            bouton.configure(text_color=WHITE if nom == selected_statement["value"] else UI_TEXT)

    def update_delete_button():
        etat = "normal" if var_preset.get().strip() else "disabled"
        btn_delete_preset.configure(state=etat)

    def refresh_preset_combo(select=""):
        presets = get_presets_pour_utilisateur(config, ut_code)
        noms = sorted(presets.keys(), key=lambda s: s.lower())
        cb_preset.configure(values=noms)
        var_preset.set(select if select in noms else "")
        preset_precedent["value"] = var_preset.get()
        update_delete_button()

    def get_date_value():
        try:
            return date_entry.get_date().strftime("%d.%m.%Y")
        except Exception:
            txt = date_entry.get().strip()
            return normaliser_date(txt)

    def set_today():
        date_entry.set_date(datetime.today())
        mark_dirty()

    def choisir_output_dir():
        initialdir = var_output_dir.get().strip() or str(Path.home())
        dossier = filedialog.askdirectory(
            title="Choisir le répertoire output",
            initialdir=initialdir
        )
        if not dossier:
            return

        var_output_dir.set(dossier)

        try:
            sauvegarder_output_dir_pour_utilisateur(config, ut_code, dossier)
            sauvegarder_config(config)
            log(f"Répertoire output sauvegardé immédiatement pour {ut_code} : {dossier}")
        except Exception as e:
            messagebox.showerror(
                "Erreur",
                f"Impossible d'enregistrer le répertoire output dans le JSON : {e}"
            )

        rafraichir_info_output()
        mark_dirty()

    def construire_df_depuis_ui():
        liste_n_intv = get_liste_n_intv()

        if not liste_n_intv:
            raise ValueError("Merci de saisir, coller ou charger au moins un Numéro d'intervenant.")

        chemin_output = var_output_dir.get().strip()
        if not chemin_output:
            raise ValueError("Merci de choisir un répertoire output.")
        if not os.path.isdir(chemin_output):
            raise ValueError("Le répertoire output sélectionné est introuvable ou inaccessible.")

        df_local = construire_dataframe_depuis_n_intv(liste_n_intv, date_defaut=get_date_value())

        for idx in df_local.index:
            df_local.at[idx, "Date"] = get_date_value()
            df_local.at[idx, "Statement_type"] = selected_statement["value"].strip().upper()
