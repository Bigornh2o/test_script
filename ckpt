            sauvegarder_config(config)
            log(f"Répertoire output sauvegardé immédiatement pour {ut_code} : {dossier}")
        except Exception as e:
            messagebox.showerror(
                "Erreur",
                f"Impossible d'enregistrer le répertoire output dans le JSON : {e}"
            )

        rafraichir_info_output()
        mark_dirty()

    def construire_df_depuis_ui():
        liste_n_intv = get_liste_n_intv()

        if not liste_n_intv:
            raise ValueError("Merci de saisir, coller ou charger au moins un Numéro d'intervenant.")

        chemin_output = var_output_dir.get().strip()
        if not chemin_output:
            raise ValueError("Merci de choisir un répertoire output.")
        if not os.path.isdir(chemin_output):
            raise ValueError("Le répertoire output sélectionné est introuvable ou inaccessible.")

        df_local = construire_dataframe_depuis_n_intv(liste_n_intv, date_defaut=get_date_value())

        for idx in df_local.index:
            df_local.at[idx, "Date"] = get_date_value()
            df_local.at[idx, "Statement_type"] = selected_statement["value"].strip().upper()
            df_local.at[idx, "Performance_type"] = var_perf.get().strip()
            df_local.at[idx, "Est_currency"] = var_currency.get().strip()
            df_local.at[idx, "Language"] = var_lang.get().strip()
            df_local.at[idx, "Monthly_perf_history"] = var_monthly.get().strip()
            df_local.at[idx, "Annual_perf_history"] = var_annual.get().strip()
            df_local.at[idx, "Anonymized_document"] = bool(var_anonymized.get())
            df_local.at[idx, "Client_signature"] = bool(var_signature.get())

        return df_local

    def appliquer_preset_sur_formulaire(preset):
        txt_n_intv.delete("1.0", "end")
        txt_n_intv.insert("1.0", "\n".join(preset.get("n_intv", [])))

        params = preset.get("params", {})

        selected_statement["value"] = str(
            params.get("statement_type", DEFAULT_GUI_VALUES["Statement_type"])
        ).strip().upper() or DEFAULT_GUI_VALUES["Statement_type"]
        refresh_statement_buttons()

        var_currency.set(str(params.get("currency", DEFAULT_GUI_VALUES["Est_currency"])).strip() or DEFAULT_GUI_VALUES["Est_currency"])
        var_lang.set(str(params.get("language", DEFAULT_GUI_VALUES["Language"])).strip() or DEFAULT_GUI_VALUES["Language"])
        var_anonymized.set(bool(params.get("anonymized", DEFAULT_GUI_VALUES["Anonymized_document"])))
        var_signature.set(bool(params.get("signature", DEFAULT_GUI_VALUES["Client_signature"])))
        var_perf.set(str(params.get("performance_type", DEFAULT_GUI_VALUES["Performance_type"])).strip() or DEFAULT_GUI_VALUES["Performance_type"])
        var_monthly.set(str(params.get("monthly_perf_history", DEFAULT_GUI_VALUES["Monthly_perf_history"])).strip() or DEFAULT_GUI_VALUES["Monthly_perf_history"])
        var_annual.set(str(params.get("annual_perf_history", DEFAULT_GUI_VALUES["Annual_perf_history"])).strip() or DEFAULT_GUI_VALUES["Annual_perf_history"])

        output_path_preset = str(params.get("output_path", "")).strip()
        if output_path_preset:
            if os.path.isdir(output_path_preset):
                var_output_dir.set(output_path_preset)
            else:
                messagebox.showwarning(
                    "Répertoire introuvable",
                    f"Le répertoire du paramétrage n'existe plus :\n{output_path_preset}\n\nLe répertoire output actuel est conservé."
                )

        mettre_a_jour_compteur()
        rafraichir_info_output()
        mark_dirty()

    def charger_derniers_parametres_ui():
        last_params = charger_last_params_pour_utilisateur(config, ut_code)

        if not isinstance(last_params, dict) or not last_params:
            messagebox.showinfo(
                "Derniers paramètres",
                "Aucun dernier paramétrage n'est disponible pour cet utilisateur."
            )
            return

        if formulaire_modifie_depuis_reference():
            ok = messagebox.askyesno(
                "Charger les derniers paramètres",
                "Le formulaire contient des modifications non enregistrées.\n"
                "Charger les derniers paramètres quand même ?"
            )
            if not ok:
                return

        appliquer_preset_sur_formulaire(normalize_preset_payload(last_params))
        var_preset.set("")
        preset_precedent["value"] = ""
        update_delete_button()
        set_reference_state()

        lbl_status.config(text="✓ Derniers paramètres chargés", fg=GREEN)
        log(f"Derniers paramètres chargés pour {ut_code}")

    def valider_formulaire(afficher_message_succes=True):
        nonlocal data_validee, df_courant
        try:
            df_courant = construire_df_depuis_ui()

            chemin_output = var_output_dir.get().strip()
            sauvegarder_output_dir_pour_utilisateur(config, ut_code, chemin_output)

            payload = get_params_preset()
            sauvegarder_last_params_pour_utilisateur(config, ut_code, payload)

            sauvegarder_config(config)

        except Exception as e:
            messagebox.showerror("Erreur", f"Validation impossible : {e}")
            return False

        data_validee = True

        if afficher_message_succes:
            lbl_status.config(
                text=f"✓ Data validée ({len(df_courant)} numéro(s) d'intervenant) | UT : {ut_code}",
                fg=GREEN
            )

        btn_generate.config(state="normal")
        log(
            f"DataFrame validé en mémoire. Output dir + derniers paramètres sauvegardés pour "
            f"{ut_code} : {var_output_dir.get().strip()}"
        )
        return True

