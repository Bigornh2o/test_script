        if formulaire_modifie_depuis_reference():
            ok = messagebox.askyesno(
                "Reset",
                "Le formulaire contient des modifications non enregistrées.\nRéinitialiser quand même ?"
            )
            if not ok:
                return

        txt_n_intv.delete("1.0", "end")

        selected_statement["value"] = DEFAULT_GUI_VALUES["Statement_type"]
        refresh_statement_buttons()

        var_perf.set(DEFAULT_GUI_VALUES["Performance_type"])
        var_currency.set(DEFAULT_GUI_VALUES["Est_currency"])
        var_lang.set(DEFAULT_GUI_VALUES["Language"])
        var_monthly.set(DEFAULT_GUI_VALUES["Monthly_perf_history"])
        var_annual.set(DEFAULT_GUI_VALUES["Annual_perf_history"])
        var_anonymized.set(DEFAULT_GUI_VALUES["Anonymized_document"])
        var_signature.set(DEFAULT_GUI_VALUES["Client_signature"])

        try:
            date_entry.set_date(datetime.today())
        except Exception:
            pass

        var_preset.set("")
        preset_precedent["value"] = ""
        update_delete_button()

        mettre_a_jour_compteur()
