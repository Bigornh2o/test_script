def get_ut_code():
    """
    Essaie de récupérer le code UT Windows.
    Exemple attendu : ut34e9
    """
    candidats = []

    try:
        candidats.append(os.getlogin())
    except Exception:
        pass

    for var in ["USERNAME", "USER", "LOGNAME"]:
        val = os.environ.get(var)
        if val:
            candidats.append(val)

    try:
        home_name = Path.home().name
        if home_name:
            candidats.append(home_name)
    except Exception:
        pass

    for val in candidats:
        val = str(val).strip()
        if re.fullmatch(r"ut[a-zA-Z0-9]+", val, flags=re.IGNORECASE):
            return val.lower()

    for val in candidats:
        val = str(val).strip()
        if val:
            return val.lower()

    return "unknown_user"


