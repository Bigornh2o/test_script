def extraire_entetes(table) -> list[str]:
    entetes = []
    headers = table.locator("thead th")

    for index in range(headers.count()):
        texte = nettoyer_texte(headers.nth(index).inner_text())

        if index == 0 and not texte:
            texte = "Type"

        if not texte:
            texte = f"Colonne_{index + 1}"

        entetes.append(texte)

    return entetes


def trouver_index(entetes: list[str], alias: list[str]):
    alias_normalises = {normaliser(a) for a in alias}

    for index, nom in enumerate(entetes):
        if normaliser(nom) in alias_normalises:
            return index

    return None


def construire_colonnes(entetes: list[str]) -> dict:
    idx_ref = trouver_index(entetes, ALIAS_REFERENCE)

    if idx_ref is None:
        raise RuntimeError(
            "Colonne Référence introuvable dans les en-têtes Jira : "
            f"{entetes}"
        )

    colonnes = {
        "noms": entetes,
        "nb": len(entetes),
        "type": trouver_index(entetes, ALIAS_TYPE),
        "ref": idx_ref,
        "iwm": trouver_index(entetes, ALIAS_URL_IWM),
        "creation": trouver_index(entetes, ALIAS_CREATION),
        "mise_a_jour": trouver_index(entetes, ALIAS_MISE_A_JOUR),
    }

    log(
        f"{colonnes['nb']} colonne(s) détectée(s) : "
        f"Type={colonnes['type']}, "
        f"Référence={colonnes['ref']}, "
        f"URL IWM={colonnes['iwm']}, "
        f"Création={colonnes['creation']}, "
        f"Mise à jour={colonnes['mise_a_jour']}"
    )

    return colonnes


