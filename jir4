MOIS_FR = {
    "jan": 1,
    "janv": 1,
    "fev": 2,
    "fevr": 2,
    "mar": 3,
    "mars": 3,
    "avr": 4,
    "mai": 5,
    "juin": 6,
    "jui": 7,
    "juil": 7,
    "aou": 8,
    "aout": 8,
    "sep": 9,
    "sept": 9,
    "oct": 10,
    "nov": 11,
    "dec": 12,
}


def convertir_heure_am_pm(
    heure: int,
    minute: int,
    am_pm: str
) -> tuple[int, int]:
    """Convertit une heure AM/PM au format 24 heures."""
    am_pm = am_pm.lower()

    if am_pm == "pm" and heure != 12:
        heure += 12
    elif am_pm == "am" and heure == 12:
        heure = 0

    return heure, minute


def convertir_date_jira(
    valeur,
    date_reference: datetime
):
    """
    Convertit les formats de dates Jira en datetime.

    Formats pris en charge :
      - 05/nov./25 6:29 AM
      - 20/janv./25 3:07 PM
      - 19/juin/26 4:54 PM
      - 05/août/25 9:17 AM
      - Hier 11:10 AM
      - Il y a 5 heures
      - Il y a 10 minutes
      - Il y a 2 jours 9:22 AM
      - Il y a 1 semaine 8:19 AM
    """
    if valeur is None or pd.isna(valeur):
        return pd.NaT

    texte_original = nettoyer_texte(valeur)

    if not texte_original:
        return pd.NaT

    texte = normaliser(texte_original)

    match = re.fullmatch(
        r"hier\s+(\d{1,2}):(\d{2})\s*(am|pm)",
        texte
    )

    if match:
        heure, minute = convertir_heure_am_pm(
            int(match.group(1)),
            int(match.group(2)),
            match.group(3)
        )

        resultat = date_reference - timedelta(days=1)

        return resultat.replace(
            hour=heure,
            minute=minute,
            second=0,
            microsecond=0
        )

    match = re.fullmatch(
        r"il y a\s+(\d+)\s+heure[s]?",
        texte
    )

    if match:
        return (
            date_reference - timedelta(hours=int(match.group(1)))
        ).replace(
            second=0,
            microsecond=0
        )

    match = re.fullmatch(
        r"il y a\s+(\d+)\s+minute[s]?",
        texte
    )

    if match:
        return (
            date_reference - timedelta(minutes=int(match.group(1)))
        ).replace(
            second=0,
            microsecond=0
        )

    match = re.fullmatch(
        r"il y a\s+(\d+)\s+jour[s]?\s+"
        r"(\d{1,2}):(\d{2})\s*(am|pm)",
        texte
    )

    if match:
        nb_jours = int(match.group(1))

        heure, minute = convertir_heure_am_pm(
            int(match.group(2)),
            int(match.group(3)),
            match.group(4)
        )

        resultat = date_reference - timedelta(days=nb_jours)

        return resultat.replace(
            hour=heure,
            minute=minute,
            second=0,
            microsecond=0
        )

    match = re.fullmatch(
        r"il y a\s+(\d+)\s+semaine[s]?\s+"
        r"(\d{1,2}):(\d{2})\s*(am|pm)",
        texte
    )

    if match:
        nb_semaines = int(match.group(1))

        heure, minute = convertir_heure_am_pm(
            int(match.group(2)),
            int(match.group(3)),
            match.group(4)
        )

        resultat = date_reference - timedelta(weeks=nb_semaines)

        return resultat.replace(
            hour=heure,
            minute=minute,
            second=0,
            microsecond=0
        )

    match = re.fullmatch(
        r"(\d{1,2})/([a-z]+)\.?/(\d{2,4})\s+"
        r"(\d{1,2}):(\d{2})\s*(am|pm)",
        texte
    )

    if match:
        jour = int(match.group(1))
        mois_texte = match.group(2)
        annee = int(match.group(3))

        heure, minute = convertir_heure_am_pm(
            int(match.group(4)),
            int(match.group(5)),
            match.group(6)
        )

        mois = MOIS_FR.get(mois_texte)

        if mois is None:
            log(
                f"Mois non reconnu dans date Jira : "
                f"« {texte_original} »"
            )
            return pd.NaT

        if annee < 100:
            annee += 2000

        try:
            return datetime(annee, mois, jour, heure, minute)

        except ValueError:
            log(
                f"Date invalide dans Jira : "
                f"« {texte_original} »"
            )
            return pd.NaT

    log(f"Format date Jira non reconnu : « {texte_original} »")

    return pd.NaT


def convertir_colonne_date(
    df: pd.DataFrame,
    nom_colonne: str,
    date_reference: datetime
) -> None:
    """Convertit une colonne Jira en datetime et écrit un log de contrôle."""
    if nom_colonne not in df.columns:
        return

    valeurs_avant_conversion = df[nom_colonne].copy()

    df[nom_colonne] = df[nom_colonne].apply(
        lambda valeur: convertir_date_jira(
            valeur=valeur,
            date_reference=date_reference
        )
    )

    nb_non_converties = (
        df[nom_colonne].isna()
        & valeurs_avant_conversion.notna()
        & (valeurs_avant_conversion.astype(str).str.strip() != "")
    ).sum()

    log(
        f"Colonne « {nom_colonne} » convertie. "
        f"{nb_non_converties} valeur(s) non reconnue(s)."
    )


