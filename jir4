def attendre_fenetre_colonnes(page) -> None:
    """
    Attend l'apparition réelle de la fenêtre 'Colonnes'
    et du champ de recherche.
    """
    log("Attente de la fenêtre 'Colonnes'...")

    try:
        page.locator(f"text={COLONNES_DIALOG_TEXT}").first.wait_for(
            state="visible",
            timeout=30000
        )
        page.locator(COLONNES_RECHERCHE_SELECTOR).first.wait_for(
            state="visible",
            timeout=30000
        )
    except PWTimeout:
        raise RuntimeError(
            "La fenêtre 'Colonnes' n'est pas apparue dans le délai imparti."
        )


def ouvrir_fenetre_colonnes(page) -> None:
    """
    Clique sur 'Modifier les colonnes' puis attend la fenêtre.
    """
    log("Clic sur 'Modifier les colonnes'...")

    bouton = page.locator(MODIFIER_COLONNES_BUTTON_SELECTOR).first

    if bouton.count() == 0:
        bouton = page.get_by_text("Modifier les colonnes", exact=True).first

    if bouton.count() == 0:
        raise RuntimeError("Bouton 'Modifier les colonnes' introuvable.")

    bouton.click()
    attendre_fenetre_colonnes(page)
    log("Fenêtre 'Colonnes' détectée.")


def _trouver_ligne_colonne(page, libelle: str):
    """
    Recherche la ligne/label correspondant au libellé saisi.
    On vise la liste filtrée dans la fenêtre colonnes.
    """
    liste = page.locator(COLONNES_LIST_SELECTOR).first

    if liste.count() == 0:
        raise RuntimeError("Liste des colonnes introuvable dans la fenêtre.")

    ligne = liste.locator("label").filter(has_text=libelle).first

    try:
        ligne.wait_for(state="visible", timeout=10000)
    except PWTimeout:
        raise RuntimeError(
            f"Libellé colonne introuvable après recherche : '{libelle}'."
        )

    return ligne


def _case_est_cochee(ligne) -> bool:
    """
    Détermine si la case associée à la ligne est déjà cochée.
    """
    checkbox = ligne.locator("input[type='checkbox']").first

    if checkbox.count() == 0:
        raise RuntimeError("Checkbox introuvable sur la ligne colonne.")

    try:
        return checkbox.is_checked()
    except Exception:
        valeur = checkbox.get_attribute("checked")
        return valeur is not None


def rechercher_et_cocher_colonne(page, libelle: str) -> None:
    """
    Tape le libellé dans la recherche, coche la case si nécessaire,
    puis efface le champ.
    """
    log(f"Sélection de la colonne : {libelle}")

    champ = page.locator(COLONNES_RECHERCHE_SELECTOR).first

    if champ.count() == 0:
        raise RuntimeError("Champ 'Rechercher des libellés' introuvable.")

    champ.click()
    champ.fill("")
    time.sleep(0.2)

    champ.fill(libelle)
    time.sleep(0.5)

    ligne = _trouver_ligne_colonne(page, libelle)

    if not _case_est_cochee(ligne):
        checkbox = ligne.locator("input[type='checkbox']").first

        try:
            checkbox.check(force=True)
        except Exception:
            ligne.click(force=True)

        time.sleep(0.3)
        log(f"Case cochée pour : {libelle}")
    else:
        log(f"Case déjà cochée pour : {libelle}")

    champ.click()
    champ.fill("")
    time.sleep(0.2)


def enregistrer_colonnes(page) -> None:
    """
    Clique sur Enregistrer et attend la fermeture de la fenêtre.
    """
    log("Clic sur 'Enregistrer'...")

    bouton = page.locator(COLONNES_SAVE_BUTTON_SELECTOR).first

    if bouton.count() == 0:
        bouton = page.get_by_role("button", name="Enregistrer").first

    if bouton.count() == 0:
        raise RuntimeError("Bouton 'Enregistrer' introuvable.")

    bouton.click()

    try:
        page.locator(COLONNES_RECHERCHE_SELECTOR).first.wait_for(
            state="hidden",
            timeout=30000
        )
    except PWTimeout:
        try:
            page.locator(f"text={COLONNES_DIALOG_TEXT}").first.wait_for(
                state="hidden",
                timeout=5000
            )
        except PWTimeout:
            raise RuntimeError(
                "La fenêtre 'Colonnes' ne s'est pas fermée après 'Enregistrer'."
            )

    log("Fenêtre 'Colonnes' fermée après enregistrement.")


def configurer_colonnes_avant_scroll(page) -> None:
    """
    Séquence avant scroll :
      1. cliquer sur Modifier les colonnes
      2. attendre la fenêtre
      3. rechercher / cocher chaque libellé
      4. enregistrer
      5. ensuite seulement la pagination/scroll peut commencer
    """
    log("Configuration des colonnes avant scroll...")

    ouvrir_fenetre_colonnes(page)

    for libelle in COLONNES_A_SELECTIONNER:
        rechercher_et_cocher_colonne(page, libelle)

    enregistrer_colonnes(page)

    try:
        page.locator(TABLE_SELECTOR).first.wait_for(state="visible", timeout=30000)
    except PWTimeout:
        raise RuntimeError("Le tableau Jira n'est plus visible après sauvegarde.")

    time.sleep(1)
    log("Configuration des colonnes terminée.")


