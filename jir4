# EXTRACTION DES DONNEES
# ============================================================

def extraire_donnees_cellule(
    page,
    cellule,
    index_colonne: int,
    colonnes: dict
) -> tuple[str, str]:

    if index_colonne == colonnes["type"]:
        icone_type = cellule.locator(
            "[data-testid='request-type-icon']"
        )

        if icone_type.count() > 0:
            texte = (
                icone_type.get_attribute("title")
                or icone_type.get_attribute("aria-label")
                or cellule.inner_text()
            )
        else:
            texte = cellule.inner_text()

        return nettoyer_texte(texte), ""

    if index_colonne == colonnes["ref"]:
        lien = cellule.locator("a").first

        if lien.count() > 0:
            texte = nettoyer_texte(lien.inner_text())
            href = lien.get_attribute("href") or ""

            return texte, convertir_url_absolue(page, href)

        return nettoyer_texte(cellule.inner_text()), ""

    if index_colonne == colonnes["iwm"]:
        lien = cellule.locator("a").first

        if lien.count() > 0:
            texte = nettoyer_texte(lien.inner_text())
            href = lien.get_attribute("href") or ""

            if not href and texte.startswith(("https://", "http://")):
                href = texte

            return texte, convertir_url_absolue(page, href)

        texte = nettoyer_texte(cellule.inner_text())

        if texte.startswith(("https://", "http://")):
            return texte, texte

        return texte, ""

    return nettoyer_texte(cellule.inner_text()), ""


def extraire_page_courante(page, table, colonnes: dict) -> list[dict]:
    resultats = []
    nb_colonnes = colonnes["nb"]

    rows = table.locator(ROWS_SELECTOR)
    nb_rows = rows.count()

    log(f"{nb_rows} ligne(s) trouvée(s) sur cette page.")

    for index_ligne in range(nb_rows):
        row = rows.nth(index_ligne)
        cellules = row.locator("td")

        if cellules.count() != nb_colonnes:
            log(
                f"Ligne {index_ligne + 1} ignorée : "
                f"{cellules.count()} cellule(s) au lieu de "
                f"{nb_colonnes}."
            )
            continue

        valeurs = []
        reference_url = ""
        url_iwm_url = ""

        for index_colonne in range(nb_colonnes):
            texte, url = extraire_donnees_cellule(
                page=page,
                cellule=cellules.nth(index_colonne),
                index_colonne=index_colonne,
                colonnes=colonnes
            )

            valeurs.append(texte)

            if index_colonne == colonnes["ref"]:
                reference_url = url

            elif index_colonne == colonnes["iwm"]:
                url_iwm_url = url

        resultats.append(
            {
                "values": valeurs,
                "reference_url": reference_url,
                "url_iwm_url": url_iwm_url
            }
        )

    return resultats


def get_premiere_reference(table, colonnes: dict) -> str:
    rows = table.locator(ROWS_SELECTOR)

    if rows.count() == 0:
        return ""

    cellules = rows.first.locator("td")

    if cellules.count() <= colonnes["ref"]:
        return ""

    return nettoyer_texte(
        cellules.nth(colonnes["ref"]).inner_text()
    )


# ============================================================
# PAGINATION — NE PAS MODIFIER
# ============================================================

def get_nombre_total_pages_apres_premier_scrap(page) -> int:
    descendre_jusqu_a_pagination(page)

    pagination = page.locator(PAGINATION_SELECTOR)

    try:
        pagination.wait_for(state="visible", timeout=30000)
    except PWTimeout:
        log("Pagination non visible : le script traitera une seule page.")
        return 1

    spans = page.locator(PAGE_COUNT_SELECTOR)

    if spans.count() < 2:
        log("Compteur de pages incomplet : une seule page sera traitée.")
        return 1

    try:
        total = int(nettoyer_texte(spans.last.inner_text()))
        log(f"Nombre total de pages détecté : {total}")
        return total

    except (ValueError, TypeError):
        log("Compteur de pages illisible : une seule page sera traitée.")
        return 1


def attendre_tableau_charge(
    page,
    ancienne_reference: str,
    colonnes: dict,
    timeout: int = 30000
) -> bool:
    try:
        page.wait_for_function(
            """
            ([ancienne_ref, nb_cols, idx_ref]) => {
                const rows = document.querySelectorAll(
                    "table.ext_ui_table tbody "
                    + "tr.ext_table_row.ext_table_row__body"
                );

                if (rows.length === 0) {
                    return false;
                }

                for (const row of rows) {
                    if (row.querySelectorAll("td").length !== nb_cols) {
                        return false;
                    }

                    if (
                        !row.children[idx_ref]
                        || !row.children[idx_ref].innerText.trim()
                    ) {
                        return false;
                    }
                }

                return rows[0].children[idx_ref].innerText.trim()
                    !== (ancienne_ref || "").trim();
            }
            """,
            arg=[
                ancienne_reference,
                colonnes["nb"],
                colonnes["ref"]
            ],
            timeout=timeout
        )

        return True

    except PWTimeout:
        return False


def aller_page_suivante(
    page,
    table,
    page_actuelle: int,
    colonnes: dict
) -> None:
    bouton_next = page.locator(NEXT_BUTTON_SELECTOR)

    if bouton_next.count() == 0:
        raise RuntimeError(
            f"Bouton Next introuvable après la page {page_actuelle}."
        )

    if bouton_next.is_disabled():
        raise RuntimeError(
            f"Bouton Next désactivé après la page {page_actuelle}."
        )

    ancienne_reference = get_premiere_reference(table, colonnes)

    log(
        f"Clic sur Next : passage de la page "
        f"{page_actuelle} à la page {page_actuelle + 1}."
    )

    bouton_next.click()

    if not attendre_tableau_charge(
        page=page,
        ancienne_reference=ancienne_reference,
        colonnes=colonnes
    ):
        raise RuntimeError(
            f"La page {page_actuelle + 1} ne s'est pas chargée "
            "(Référence inchangée après 30 s)."
        )

    time.sleep(1)


# ============================================================
# CONSTRUCTION DU DATAFRAME
# ============================================================

def extraire_dataframe_complet(
    page
) -> tuple[pd.DataFrame, dict, dict, dict]:

    table = page.locator(TABLE_SELECTOR)
    table.wait_for(state="visible", timeout=60000)

    log("Tableau Jira détecté.")

    # Configuration des colonnes AVANT tout scroll/pagination
    configurer_colonnes_avant_scroll(page)

    # Après sauvegarde, on relocalise le tableau.
    table = page.locator(TABLE_SELECTOR)
    table.wait_for(state="visible", timeout=60000)

    entetes = extraire_entetes(table)

    if not entetes:
        entetes = ENTETES_PAR_DEFAUT
        log("En-têtes non lus : application des noms par défaut.")

    colonnes = construire_colonnes(entetes)

    # Page 1
    log("===== Extraction de la première page =====")

    toutes_les_lignes = extraire_page_courante(
        page=page,
        table=table,
        colonnes=colonnes
    )

    log(
        f"Première page extraite : "
        f"{len(toutes_les_lignes)} ligne(s)."
    )

    # Pagination après lecture de la première page.
    nb_pages = get_nombre_total_pages_apres_premier_scrap(page)

    # Pages 2 à N
    for numero_page in range(2, nb_pages + 1):
        page_actuelle = numero_page - 1

        log(
            f"===== Préparation extraction page "
            f"{numero_page}/{nb_pages} ====="
        )

        aller_page_suivante(
            page=page,
            table=table,
            page_actuelle=page_actuelle,
            colonnes=colonnes
        )

        remonter_au_tableau(
            page=page,
            table=table
        )

        lignes_page = extraire_page_courante(
            page=page,
            table=table,
            colonnes=colonnes
        )

        if not lignes_page:
            log("Aucune ligne lue : nouvel essai dans 3 secondes...")
            time.sleep(3)

            remonter_au_tableau(
                page=page,
                table=table
            )

            lignes_page = extraire_page_courante(
                page=page,
                table=table,
                colonnes=colonnes
            )

        toutes_les_lignes.extend(lignes_page)

        log(
            f"Page {numero_page}/{nb_pages} extraite : "
            f"{len(lignes_page)} ligne(s)."
        )

        if numero_page < nb_pages:
            descendre_jusqu_a_pagination(page)

    # NOUVEAU : à la fin, restaurer les paramètres par défaut
    restaurer_parametres_colonnes_par_defaut(page)

    # Construction des données et liens.
    data = []
    liens_references = {}
    liens_url_iwm = {}

    for ligne in toutes_les_lignes:
        valeurs = ligne["values"]

        if len(valeurs) != colonnes["nb"]:
            continue

        data.append(valeurs)

        reference = valeurs[colonnes["ref"]]

        if reference and ligne["reference_url"]:
            liens_references[reference] = ligne["reference_url"]

        if colonnes["iwm"] is not None:
            valeur_url_iwm = valeurs[colonnes["iwm"]]

            if valeur_url_iwm and ligne["url_iwm_url"]:
                liens_url_iwm[valeur_url_iwm] = ligne["url_iwm_url"]

    df = pd.DataFrame(data, columns=colonnes["noms"])

    nom_reference = colonnes["noms"][colonnes["ref"]]

    if not df.empty:
        nb_avant = len(df)

        df = df.drop_duplicates(
            subset=[nom_reference],
            keep="first"
        ).reset_index(drop=True)

        nb_apres = len(df)

        if nb_apres < nb_avant:
            log(
                f"{nb_avant - nb_apres} doublon(s) supprimé(s) "
                f"sur la colonne {nom_reference}."
            )

    date_reference = datetime.now()

    if colonnes["creation"] is not None:
        nom_creation = colonnes["noms"][colonnes["creation"]]

        convertir_colonne_date(
            df=df,
            nom_colonne=nom_creation,
            date_reference=date_reference
        )

    if colonnes["mise_a_jour"] is not None:
        nom_mise_a_jour = colonnes["noms"][colonnes["mise_a_jour"]]

        convertir_colonne_date(
            df=df,
            nom_colonne=nom_mise_a_jour,
            date_reference=date_reference
        )

    return df, liens_references, liens_url_iwm, colonnes


# ============================================================
# EXPORT EXCEL
# ============================================================

def appliquer_hyperliens(
    ws,
    nom_colonne: str,
    liens: dict,
    accepter_url_brute: bool = False
) -> None:

    index_colonne = None

    for cellule in ws[1]:
        if nettoyer_texte(cellule.value) == nom_colonne:
            index_colonne = cellule.column
            break

    if index_colonne is None:
        log(f"Colonne « {nom_colonne} » introuvable dans Excel.")
        return

    compteur = 0

    for numero_ligne in range(2, ws.max_row + 1):
        cellule = ws.cell(
            row=numero_ligne,
            column=index_colonne
        )

        valeur = nettoyer_texte(cellule.value)
        url = liens.get(valeur, "")

        if (
            not url
            and accepter_url_brute
            and valeur.startswith(("https://", "http://"))
        ):
            url = valeur

        if url:
            cellule.hyperlink = url
            cellule.font = Font(
                color="0563C1",
                underline="single"
            )
            compteur += 1

    log(
        f"{compteur} lien(s) créé(s) dans la colonne "
        f"« {nom_colonne} »."
    )


def ajuster_largeurs_colonnes(ws) -> None:
    largeurs = {
        normaliser(nom): largeur
        for nom, largeur in LARGEURS_COLONNES.items()
    }

    for cellule in ws[1]:
        lettre = get_column_letter(cellule.column)

        largeur = largeurs.get(
            normaliser(cellule.value),
            LARGEUR_PAR_DEFAUT
        )

        ws.column_dimensions[lettre].width = largeur


def formater_colonne_date_excel(
    ws,
    nom_colonne: str
) -> None:
    """Applique le format dd/mm/yyyy hh:mm à une colonne Excel."""
    index_colonne = None

    for cellule in ws[1]:
        if nettoyer_texte(cellule.value) == nom_colonne:
            index_colonne = cellule.column
            break

    if index_colonne is None:
        return

    for numero_ligne in range(2, ws.max_row + 1):
        ws.cell(
            row=numero_ligne,
            column=index_colonne
        ).number_format = "dd/mm/yyyy hh:mm"


def exporter_vers_excel(
    df: pd.DataFrame,
    liens_references: dict,
    liens_url_iwm: dict,
    colonnes: dict,
    chemin_fichier: str
) -> None:

    os.makedirs(OUTPUT_DIR, exist_ok=True)

    df.to_excel(
        chemin_fichier,
        index=False,
        sheet_name="Demandes",
        engine="openpyxl"
    )

    wb = load_workbook(chemin_fichier)
    ws = wb["Demandes"]

    for cellule in ws[1]:
        cellule.font = Font(
            bold=True,
            color="FFFFFF"
        )

        cellule.fill = PatternFill(
            fill_type="solid",
            fgColor="17365D"
        )

        cellule.alignment = Alignment(
            horizontal="center",
            vertical="center",
            wrap_text=True
        )

    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions

    for row in ws.iter_rows(min_row=2):
        for cellule in row:
            cellule.alignment = Alignment(
                vertical="top",
                wrap_text=True
            )

    appliquer_hyperliens(
        ws=ws,
        nom_colonne=colonnes["noms"][colonnes["ref"]],
        liens=liens_references
    )

    if colonnes["iwm"] is not None:
        appliquer_hyperliens(
            ws=ws,
            nom_colonne=colonnes["noms"][colonnes["iwm"]],
            liens=liens_url_iwm,
            accepter_url_brute=True
        )

    if colonnes["creation"] is not None:
        formater_colonne_date_excel(
            ws=ws,
            nom_colonne=colonnes["noms"][colonnes["creation"]]
        )

    if colonnes["mise_a_jour"] is not None:
        formater_colonne_date_excel(
            ws=ws,
            nom_colonne=colonnes["noms"][colonnes["mise_a_jour"]]
        )

    ajuster_largeurs_colonnes(ws)

    for numero_ligne in range(2, ws.max_row + 1):
        ws.row_dimensions[numero_ligne].height = 35

    wb.save(chemin_fichier)


# ============================================================
# EXECUTION PRINCIPALE
# ============================================================

def run(playwright) -> bool:
    browser = playwright.chromium.launch(
        executable_path=CHROME_PATH,
        headless=HEADLESS
    )

    try:
        context = browser.new_context(
            viewport={
                "width": 1920,
                "height": 1080
            },
            accept_downloads=False
        )

        page = context.new_page()
        page.set_default_timeout(30000)

        log("Ouverture de Jira...")
        page.goto(JIRA_URL, timeout=60000)

        try:
            page.wait_for_load_state("networkidle", timeout=60000)
        except PWTimeout:
            log("Chargement Jira partiel ; poursuite.")

        log("Clic sur SSO KEYCLOAK...")
        page.get_by_role(
            "link",
            name="SSO KEYCLOAK"
        ).click()

        try:
            page.wait_for_load_state("networkidle", timeout=60000)
        except PWTimeout:
            log("Chargement partiel après SSO ; poursuite.")

        log("Clic sur Indosuez (FR, CH, Middle East)...")
        page.locator("#social-CAGIP").click()

        try:
            page.wait_for_load_state("networkidle", timeout=60000)
        except PWTimeout:
            log("Chargement partiel après sélection Indosuez ; poursuite.")

        log("Attente de la page Demandes...")

        try:
            page.get_by_text(
                "Demandes",
                exact=True
            ).wait_for(timeout=60000)

        except PWTimeout:
            log(
                "Titre « Demandes » non détecté ; "
                "vérification directe du tableau."
            )

        log("Début de l'extraction Jira...")

        df, liens_references, liens_url_iwm, colonnes = (
            extraire_dataframe_complet(page)
        )

        if df.empty:
            log("Aucune donnée extraite.")
            return False

        log(f"{len(df)} demande(s) unique(s) extraite(s).")

        log("Création du fichier Excel...")

        exporter_vers_excel(
            df=df,
            liens_references=liens_references,
            liens_url_iwm=liens_url_iwm,
            colonnes=colonnes,
            chemin_fichier=FICHIER_EXCEL
        )

        taille = os.path.getsize(FICHIER_EXCEL)

        log(f"Fichier Excel créé : {FICHIER_EXCEL}")
        log(f"Taille : {taille:,} octets")

        print("\n--- APERÇU DU DATAFRAME ---")
        print(df.head().to_string(index=False))

        return True

    except Exception as exc:
        log(f"ERREUR : {type(exc).__name__} - {exc}")
        return False

    finally:
        browser.close()
        log("Navigateur fermé. Script terminé.")


# ============================================================
# LANCEMENT
# ============================================================

if __name__ == "__main__":
    with sync_playwright() as playwright:
        succes = run(playwright)

    sys.exit(0 if succes else 1)
