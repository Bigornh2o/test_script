def scroll_element_et_parents(page, selector: str, position: str) -> None:
    page.evaluate(
        """
        ({selector, position}) => {
            const element = document.querySelector(selector);

            if (!element) {
                return;
            }

            const root = document.scrollingElement || document.documentElement;

            let parent = element.parentElement;

            while (parent) {
                const style = window.getComputedStyle(parent);

                const isScrollableY =
                    ["auto", "scroll"].includes(style.overflowY)
                    && parent.scrollHeight > parent.clientHeight;

                if (isScrollableY) {
                    if (position === "top") {
                        parent.scrollTop = 0;
                    } else {
                        parent.scrollTop = parent.scrollHeight;
                    }
                }

                parent = parent.parentElement;
            }

            if (position === "top") {
                root.scrollTop = 0;
            } else {
                root.scrollTop = root.scrollHeight;
            }

            element.scrollIntoView({
                behavior: "auto",
                block: position === "top" ? "start" : "end",
                inline: "nearest"
            });
        }
        """,
        arg={
            "selector": selector,
            "position": position
        }
    )


def descendre_jusqu_a_pagination(page) -> None:
    log("Descente vers la pagination...")

    pagination = page.locator(PAGINATION_SELECTOR)

    try:
        pagination.wait_for(state="attached", timeout=30000)
        pagination.scroll_into_view_if_needed(timeout=30000)
    except PWTimeout:
        log("Pagination non attachée au DOM.")
        return

    scroll_element_et_parents(
        page=page,
        selector=PAGINATION_SELECTOR,
        position="bottom"
    )

    time.sleep(1)


def remonter_au_tableau(page, table) -> None:
    log("Retour au tableau de la nouvelle page...")

    try:
        table.scroll_into_view_if_needed(timeout=30000)
    except PWTimeout:
        log("Impossible de placer directement la table à l'écran.")

    scroll_element_et_parents(
        page=page,
        selector=TABLE_SELECTOR,
        position="top"
    )

    time.sleep(1)


