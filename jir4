# ============================================================
# OUTILS GENERAUX
# ============================================================
 
def log(message: str) -> None:
    """Affiche un message horodaté dans la console."""
    print(
        f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {message}",
        flush=True
    )
 
def nettoyer_texte(value) -> str:
    """Supprime les retours à la ligne, tabulations et espaces multiples."""
    if value is None:
        return ""
 
    return " ".join(str(value).split())
 
def convertir_url_absolue(page, url: str) -> str:
    """Convertit une URL relative Jira en URL absolue."""
    if not url:
        return ""
 
    return urljoin(page.url, url)
 
# ============================================================
# EXTRACTION DES EN-TETES
# ============================================================
 
def extraire_entetes(table) -> list[str]:
    """Lit les noms de colonnes dans le <thead> Jira."""
    entetes = []
    headers = table.locator("thead th")
 
    for index in range(headers.count()):
        texte = nettoyer_texte(headers.nth(index).inner_text())
 
        # La colonne Type peut être vide visuellement.
        if index == 0 and not texte:
            texte = "Type"
 
        if not texte:
            texte = f"Colonne_{index + 1}"
 
        entetes.append(texte)
 
    return entetes
 
# ============================================================
# EXTRACTION DES CELLULES
# ============================================================
 
def extraire_donnees_cellule(
    page,
    cellule,
    index_colonne: int
) -> tuple[str, str]:
    """
    Retourne :
      - le texte affiché ;
      - le lien associé, si disponible.
 
    Les colonnes Référence et URL IWM récupèrent explicitement
    leur attribut href pour être cliquables dans Excel.
    """
 
    # --------------------------------------------------------
    # Colonne 1 : Type
    # --------------------------------------------------------
    if index_colonne == 0:
        icone_type = cellule.locator(
            "[data-testid='request-type-icon']"
        )
 
        if icone_type.count() > 0:
            texte = (
                icone_type.get_attribute("title")
                or icone_type.get_attribute("aria-label")
                or cellule.inner_text()
            )
        else:
            texte = cellule.inner_text()
 
        return nettoyer_texte(texte), ""
 
    # --------------------------------------------------------
    # Colonne 2 : Référence
    # --------------------------------------------------------
    if index_colonne == 1:
        lien = cellule.locator("a").first
 
        if lien.count() > 0:
            texte = nettoyer_texte(lien.inner_text())
            href = lien.get_attribute("href") or ""
 
            return texte, convertir_url_absolue(page, href)
 
        return nettoyer_texte(cellule.inner_text()), ""
 
    # --------------------------------------------------------
    # Colonne 7 : URL IWM
    # --------------------------------------------------------
    if index_colonne == 6:
        lien = cellule.locator("a").first
 
        if lien.count() > 0:
            texte = nettoyer_texte(lien.inner_text())
            href = lien.get_attribute("href") or ""
 
            if not href and texte.startswith(("http://", "https://")):
                href = texte
 
            return texte, convertir_url_absolue(page, href)
 
        texte = nettoyer_texte(cellule.inner_text())
 
        if texte.startswith(("http://", "https://")):
            return texte, texte
 
        return texte, ""
 
    # --------------------------------------------------------
    # Autres colonnes
    # --------------------------------------------------------
    return nettoyer_texte(cellule.inner_text()), ""
 
# ============================================================
# EXTRACTION D'UNE PAGE
# ============================================================
 
def extraire_page_courante(page, table) -> list[dict]:
    """
    Extrait les demandes de la page Jira actuellement visible.
 
    Retour :
        {
            "values": [...13 valeurs...],
            "reference_url": "...",
            "url_iwm_url": "..."
        }
    """
    resultats = []
 
    rows = table.locator(ROWS_SELECTOR)
    nb_rows = rows.count()
 
    log(f"{nb_rows} ligne(s) trouvée(s) sur cette page.")
 
    for index_ligne in range(nb_rows):
        row = rows.nth(index_ligne)
        cellules = row.locator("td")
 
        if cellules.count() != NB_COLONNES_ATTENDU:
            log(
                f"Ligne {index_ligne + 1} ignorée : "
                f"{cellules.count()} cellule(s) au lieu de "
                f"{NB_COLONNES_ATTENDU}."
            )
            continue
 
        valeurs = []
        reference_url = ""
        url_iwm_url = ""
 
        for index_colonne in range(NB_COLONNES_ATTENDU):
            texte, url = extraire_donnees_cellule(
                page=page,
                cellule=cellules.nth(index_colonne),
                index_colonne=index_colonne
            )
 
            valeurs.append(texte)
 
            if index_colonne == 1:
                reference_url = url
 
            elif index_colonne == 6:
                url_iwm_url = url
 
        resultats.append(
            {
                "values": valeurs,
                "reference_url": reference_url,
                "url_iwm_url": url_iwm_url
            }
        )
 
    return resultats
 
def get_premiere_reference(table) -> str:
    """Récupère la première référence, pour confirmer le changement de page."""
    rows = table.locator(ROWS_SELECTOR)
 
    if rows.count() == 0:
        return ""
 
    cellules = rows.first.locator("td")
 
    if cellules.count() < 2:
        return ""
 
    return nettoyer_texte(cellules.nth(1).inner_text())
 
# ============================================================
# PAGINATION
# ============================================================
 
def descendre_jusqu_a_pagination(page) -> None:
    """Descend au bas de la page afin d'afficher la pagination Jira."""
    log("Descente en bas de page pour afficher la pagination...")
 
    page.evaluate(
        """
        () => window.scrollTo({
            top: document.body.scrollHeight,
            behavior: "instant"
        })
        """
    )
 
    time.sleep(1)
 
def get_nombre_total_pages_apres_premier_scrap(page) -> int:
    """
    Lit le nombre total de pages après le scraping de la première page.
 
    Exemple de compteur Jira :
        1 / 34
    """
    descendre_jusqu_a_pagination(page)
 
    pagination = page.locator(PAGINATION_SELECTOR)
 
    try:
        pagination.wait_for(state="visible", timeout=30000)
    except PWTimeout:
        log(
            "Pagination non visible. "
            "Le script considérera qu'il n'y a qu'une page."
        )
        return 1
 
    spans = page.locator(PAGE_COUNT_SELECTOR)
 
    if spans.count() < 2:
        log(
            "Compteur de pages absent ou incomplet. "
            "Le script considérera qu'il n'y a qu'une page."
        )
        return 1
 
    try:
        total = int(nettoyer_texte(spans.last.inner_text()))
        log(f"Nombre total de pages détecté : {total}")
        return total
 
    except (ValueError, TypeError):
        log(
            "Nombre de pages illisible. "
            "Le script considérera qu'il n'y a qu'une page."
        )
        return 1
 
def get_page_courante(page) -> int:
    """Lit le numéro de la page courante dans le compteur Jira."""
    spans = page.locator(PAGE_COUNT_SELECTOR)
 
    if spans.count() < 2:
        return 1
 
    try:
        return int(nettoyer_texte(spans.first.inner_text()))
    except (ValueError, TypeError):
        return 1
 
def aller_page_suivante(
    page,
    table,
    page_actuelle: int
) -> None:
    """
    Clique sur Next puis attend le chargement de la page suivante.
 
    Important :
    arg= est nécessaire avec la version actuelle de Playwright Python.
    """
    bouton_next = page.locator(NEXT_BUTTON_SELECTOR)
 
    if bouton_next.count() == 0:
        raise RuntimeError(
            f"Bouton Next introuvable après la page {page_actuelle}."
        )
 
    if bouton_next.is_disabled():
        raise RuntimeError(
            f"Bouton Next désactivé après la page {page_actuelle}."
        )
 
    ancienne_reference = get_premiere_reference(table)
 
    log(
        f"Clic sur Next : passage de la page "
        f"{page_actuelle} à la suivante."
    )
 
    bouton_next.click()
 
    # Attente du changement du numéro de page.
    try:
        page.wait_for_function(
            """
            page_attendue => {
                const spans = document.querySelectorAll(
                    "[data-testid='my-requests-pagination'] "
                    + ".ext_page_count span"
                );
 
                if (spans.length < 2) {
                    return false;
                }
 
                return spans[0].innerText.trim() === String(page_attendue);
            }
            """,
            arg=page_actuelle + 1,
            timeout=30000
        )
 
    except PWTimeout:
        log(
            "Le compteur n'a pas changé dans le délai attendu ; "
            "contrôle via la Référence."
        )
 
    # Vérification complémentaire : la première ligne du tableau change.
    if ancienne_reference:
        try:
            page.wait_for_function(
                """
                ancienne_ref => {
                    const row = document.querySelector(
                        "table.ext_ui_table tbody "
                        + "tr.ext_table_row.ext_table_row__body"
                    );
 
                    if (!row || !row.children[1]) {
                        return false;
                    }
 
                    return row.children[1].innerText.trim()
                        !== ancienne_ref.trim();
                }
                """,
                arg=ancienne_reference,
                timeout=30000
            )
 
        except PWTimeout:
            log(
                "La première Référence n'a pas changé dans le délai prévu. "
                "Le script poursuit après stabilisation."
            )
 
    # Stabilisation additionnelle du DOM Jira.
    time.sleep(1)
 
# ============================================================
# CONSTRUCTION DU DATAFRAME
# ============================================================
 
def extraire_dataframe_complet(page) -> tuple[pd.DataFrame, dict, dict]:
    """
    Processus :
      1. Lecture des 20 lignes de la page 1 ;
      2. Descente vers la pagination ;
      3. Lecture du nombre total de pages ;
      4. Extraction de chaque page suivante.
    """
    table = page.locator(TABLE_SELECTOR)
    table.wait_for(state="visible", timeout=60000)
 
    log("Tableau Jira détecté.")
 
    entetes = extraire_entetes(table)
 
    entetes_par_defaut = [
        "Type",
        "Référence",
        "Résumé",
        "Responsable",
        "État",
        "Création",
        "URL IWM",
        "Descriptif",
        "Temps écoulé pour la résolution",
        "Request participants",
        "Rapporteur",
        "Mise à jour",
        "Projet de service",
    ]
 
    if len(entetes) != NB_COLONNES_ATTENDU:
        log(
            f"{len(entetes)} en-tête(s) détecté(s). "
            "Application des noms de colonnes standards."
        )
        entetes = entetes_par_defaut
 
    # --------------------------------------------------------
    # Page 1 : scraping avant recherche pagination
    # --------------------------------------------------------
    log("===== Extraction de la première page =====")
 
    toutes_les_lignes = extraire_page_courante(
        page=page,
        table=table
    )
 
    log(
        f"Première page extraite : "
        f"{len(toutes_les_lignes)} ligne(s)."
    )
 
    # --------------------------------------------------------
    # Lecture du total après page 1
    # --------------------------------------------------------
    nb_pages = get_nombre_total_pages_apres_premier_scrap(page)
 
    # --------------------------------------------------------
    # Pages 2 à N
    # --------------------------------------------------------
    for numero_page in range(2, nb_pages + 1):
        page_actuelle = get_page_courante(page)
 
        log(
            f"===== Préparation extraction page "
            f"{numero_page}/{nb_pages} ====="
        )
 
        aller_page_suivante(
            page=page,
            table=table,
            page_actuelle=page_actuelle
        )
 
        # Retour au haut de page pour garder le tableau visible.
        page.evaluate(
            "() => window.scrollTo({top: 0, behavior: 'instant'})"
        )
 
        time.sleep(0.5)
 
        lignes_page = extraire_page_courante(
            page=page,
            table=table
        )
 
        toutes_les_lignes.extend(lignes_page)
 
        log(
            f"Page {numero_page}/{nb_pages} extraite : "
            f"{len(lignes_page)} ligne(s)."
        )
 
        # Le prochain clic Next impose de revenir à la pagination.
        if numero_page < nb_pages:
            descendre_jusqu_a_pagination(page)
 
    # --------------------------------------------------------
    # Création du DataFrame et des dictionnaires de liens
    # --------------------------------------------------------
    data = []
    liens_references = {}
    liens_url_iwm = {}
 
    for ligne in toutes_les_lignes:
        valeurs = ligne["values"]
 
        if len(valeurs) != NB_COLONNES_ATTENDU:
            continue
 
        data.append(valeurs)
 
        reference = valeurs[1]
        valeur_url_iwm = valeurs[6]
 
        if reference and ligne["reference_url"]:
            liens_references[reference] = ligne["reference_url"]
 
        if valeur_url_iwm and ligne["url_iwm_url"]:
            liens_url_iwm[valeur_url_iwm] = ligne["url_iwm_url"]
 
    df = pd.DataFrame(data, columns=entetes)
 
    # Déduplication de sécurité.
    if not df.empty and "Référence" in df.columns:
        nb_avant = len(df)
 
        df = df.drop_duplicates(
            subset=["Référence"],
            keep="first"
        ).reset_index(drop=True)
 
        nb_apres = len(df)
 
        if nb_apres < nb_avant:
            log(
                f"{nb_avant - nb_apres} doublon(s) supprimé(s) "
                "sur la colonne Référence."
            )
 
    return df, liens_references, liens_url_iwm
 
# ============================================================
# EXPORT EXCEL
# ============================================================
 
def appliquer_hyperliens(
    ws,
    nom_colonne: str,
    liens: dict
) -> None:
    """Transforme les cellules Excel d'une colonne en liens hypertextes."""
    index_colonne = None
 
    for cellule in ws[1]:
        if nettoyer_texte(cellule.value) == nom_colonne:
            index_colonne = cellule.column
            break
 
    if index_colonne is None:
        log(f"Colonne « {nom_colonne} » introuvable dans Excel.")
        return
 
    compteur = 0
 
    for numero_ligne in range(2, ws.max_row + 1):
        cellule = ws.cell(
            row=numero_ligne,
            column=index_colonne
        )
 
        valeur = nettoyer_texte(cellule.value)
        url = liens.get(valeur, "")
 
        # Cas de secours pour URL IWM.
        if (
            not url
            and nom_colonne == "URL IWM"
            and valeur.startswith(("https://", "http://"))
        ):
            url = valeur
 
        if url:
            cellule.hyperlink = url
            cellule.font = Font(
                color="0563C1",
                underline="single"
            )
            compteur += 1
 
    log(
        f"{compteur} lien(s) créé(s) dans la colonne "
        f"« {nom_colonne} »."
    )
 
def ajuster_largeurs_colonnes(ws) -> None:
    """Applique une largeur adaptée à chaque colonne Excel."""
    largeurs = {
        "A": 18,   # Type
        "B": 18,   # Référence
        "C": 45,   # Résumé
        "D": 30,   # Responsable
        "E": 25,   # État
        "F": 18,   # Création
        "G": 43,   # URL IWM
        "H": 75,   # Descriptif
        "I": 32,   # Temps écoulé pour la résolution
        "J": 35,   # Request participants
        "K": 30,   # Rapporteur
        "L": 20,   # Mise à jour
        "M": 25,   # Projet de service
    }
 
    for colonne, largeur in largeurs.items():
        ws.column_dimensions[colonne].width = largeur
 
def exporter_vers_excel(
    df: pd.DataFrame,
    liens_references: dict,
    liens_url_iwm: dict,
    chemin_fichier: str
) -> None:
    """Crée et met en forme le fichier Excel final."""
    os.makedirs(OUTPUT_DIR, exist_ok=True)
 
    df.to_excel(
        chemin_fichier,
        index=False,
        sheet_name="Demandes",
        engine="openpyxl"
    )
 
    wb = load_workbook(chemin_fichier)
    ws = wb["Demandes"]
 
    # Mise en forme de la ligne d'en-têtes.
    for cellule in ws[1]:
        cellule.font = Font(
            bold=True,
            color="FFFFFF"
        )
 
        cellule.fill = PatternFill(
            fill_type="solid",
            fgColor="17365D"
        )
 
        cellule.alignment = Alignment(
            horizontal="center",
            vertical="center",
            wrap_text=True
        )
 
    # Figer les en-têtes et activer les filtres.
    ws.freeze_panes = "A2"
    ws.auto_filter.ref = ws.dimensions
 
    # Liens dans les colonnes demandées.
    appliquer_hyperliens(
        ws=ws,
        nom_colonne="Référence",
        liens=liens_references
    )
 
    appliquer_hyperliens(
        ws=ws,
        nom_colonne="URL IWM",
        liens=liens_url_iwm
    )
 
    # Mise en forme générale.
    for row in ws.iter_rows(min_row=2):
        for cellule in row:
            cellule.alignment = Alignment(
                vertical="top",
                wrap_text=True
            )
 
    ajuster_largeurs_colonnes(ws)
 
    # Hauteur fixe pour une lisibilité minimale des descriptifs.
    for numero_ligne in range(2, ws.max_row + 1):
        ws.row_dimensions[numero_ligne].height = 35
 
    wb.save(chemin_fichier)
 
# ============================================================
# EXECUTION PRINCIPALE
# ============================================================
 
def run(playwright) -> bool:
    browser = playwright.chromium.launch(
        executable_path=CHROME_PATH,
        headless=HEADLESS
    )
 
    try:
        context = browser.new_context(
            viewport={
                "width": 1920,
                "height": 1080
            },
            accept_downloads=False
        )
 
        page = context.new_page()
        page.set_default_timeout(30000)
 
        # ----------------------------------------------------
        # 1. Ouverture Jira
        # ----------------------------------------------------
        log("Ouverture de Jira...")
        page.goto(JIRA_URL, timeout=60000)
 
        try:
            page.wait_for_load_state("networkidle", timeout=60000)
        except PWTimeout:
            log("Chargement Jira partiel ; poursuite.")
 
        # ----------------------------------------------------
        # 2. SSO Keycloak
        # ----------------------------------------------------
        log("Clic sur SSO KEYCLOAK...")
        page.get_by_role(
            "link",
            name="SSO KEYCLOAK"
        ).click()
 
        try:
            page.wait_for_load_state("networkidle", timeout=60000)
        except PWTimeout:
            log("Chargement partiel après SSO ; poursuite.")
 
        # ----------------------------------------------------
        # 3. Choix Indosuez
        # ----------------------------------------------------
        log("Clic sur Indosuez (FR, CH, Middle East)...")
        page.locator("#social-CAGIP").click()
 
        try:
            page.wait_for_load_state("networkidle", timeout=60000)
        except PWTimeout:
            log("Chargement partiel après sélection Indosuez ; poursuite.")
 
        # ----------------------------------------------------
        # 4. Attente page Demandes
        # ----------------------------------------------------
        log("Attente de la page Demandes...")
 
        try:
            page.get_by_text(
                "Demandes",
                exact=True
            ).wait_for(timeout=60000)
 
        except PWTimeout:
            log(
                "Titre « Demandes » non détecté ; "
                "vérification directe du tableau."
            )
 
        # ----------------------------------------------------
        # 5. Scraping et pagination
        # ----------------------------------------------------
        log("Début de l'extraction Jira...")
 
        df, liens_references, liens_url_iwm = (
            extraire_dataframe_complet(page)
        )
 
        if df.empty:
            log("Aucune donnée extraite.")
            return False
 
        log(f"{len(df)} demande(s) unique(s) extraite(s).")
 
        # ----------------------------------------------------
        # 6. Export Excel
        # ----------------------------------------------------
        log("Création du fichier Excel...")
 
        exporter_vers_excel(
            df=df,
            liens_references=liens_references,
            liens_url_iwm=liens_url_iwm,
            chemin_fichier=FICHIER_EXCEL
        )
 
        taille = os.path.getsize(FICHIER_EXCEL)
 
        log(f"Fichier Excel créé : {FICHIER_EXCEL}")
        log(f"Taille : {taille:,} octets")
 
        print("\n--- APERÇU DU DATAFRAME ---")
        print(df.head().to_string(index=False))
 
        return True
 
    except Exception as exc:
        log(f"ERREUR : {type(exc).__name__} - {exc}")
        return False
 
    finally:
        browser.close()
        log("Navigateur fermé. Script terminé.")
 
# ============================================================
# LANCEMENT
# ============================================================
 
if __name__ == "__main__":
    with sync_playwright() as playwright:
        succes = run(playwright)
 
    sys.exit(0 if succes else 1)