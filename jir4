def log(message: str) -> None:
    print(
        f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {message}",
        flush=True
    )


def nettoyer_texte(value) -> str:
    """Supprime les retours à la ligne, tabulations et espaces multiples."""
    if value is None:
        return ""

    return " ".join(str(value).split())


def normaliser(value) -> str:
    """Normalise le texte : minuscules et suppression des accents."""
    texte = unicodedata.normalize("NFKD", nettoyer_texte(value))
    texte = "".join(
        caractere
        for caractere in texte
        if not unicodedata.combining(caractere)
    )
    return texte.lower()


def convertir_url_absolue(page, url: str) -> str:
    """Transforme une URL Jira relative en URL absolue."""
    if not url:
        return ""

    return urljoin(page.url, url)


