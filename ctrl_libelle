# --------------------------- utils ---------------------------
def strip_accents(s):
    return "".join(c for c in unicodedata.normalize("NFKD", s) if not unicodedata.combining(c))


def clean(s):
    return re.sub(r"\s+", " ", strip_accents(str(s)).upper()).strip() if pd.notna(s) else ""


def fmt_cpn(x):
    """Coupon proposé : entier sans décimale (4), sinon au moins 2 décimales sans zéro inutile
    au-delà (1.50, 0.125, 3.5094)."""
    x = round(float(x), 6)
    if x == int(x):
        return str(int(x))
    s = f"{x:.6f}".rstrip("0")
    return s if len(s.split(".")[1]) >= 2 else f"{x:.2f}"


def cpn_ok(cpn_str):
    """Coupon accepté dans le libellé actuel : 4 / 4.0 / 4.00, 1.5 / 1.50, 0.125 ;
    refusé : zéro final au-delà de la 2e décimale (1.550, 3.000)."""
    if "." not in cpn_str:
        return True
    dec = cpn_str.split(".")[1]
    return len(dec) <= 2 or not dec.endswith("0")


def safe_date(y, m, d):
    try:
        return date(y, m, d)
    except ValueError:
        return None


def year4(y):
    y = int(y)
    return y + 2000 if y < 100 else y


# --------------------------- parsing du libellé ---------------------------
DATE_PATTERNS = [
    ("slash", re.compile(r"(?<!\d)(\d{1,2})/(\d{1,2})/(\d{4}|\d{2})(?!\d)")),
    ("dot", re.compile(r"(?<![\d.])(\d{1,2})\.(\d{1,2})\.(\d{4})(?!\d)")),
    ("mon", re.compile(r"(?<!\d)(\d{1,2})-?([A-Z]{3})-?(\d{4}|\d{2})(?!\d)")),
]


def parse_label(label):
    lab = clean(label)
    out = {"iss": "", "cpn": None, "cpn_str": "", "dates": [], "date_str": "",
           "date_fmt": "", "ddmm": None, "perp": False, "var": False, "first_token": None}
    spans = []

    # date
    for kind, pat in DATE_PATTERNS:
        m = pat.search(lab)
        if not m:
            continue
        a, b, y = m.groups()
        y = year4(y)
        cands = []
        if kind == "mon":
            if b in MONTHS:
                cands = [safe_date(y, MONTHS[b], int(a))]
            else:
                continue
        else:
            a, b = int(a), int(b)
            out["ddmm"] = safe_date(y, b, a)
            cands = [safe_date(y, b, a)]                    # dd/mm
            if kind == "slash":
                cands.append(safe_date(y, a, b))            # mm/dd (format US)
        cands = list(dict.fromkeys(c for c in cands if c))
        if cands:
            out["dates"], out["date_str"], out["date_fmt"] = cands, m.group(0), kind
            spans.append(("date", m.start(), m.end()))
            break

    # coupon (on masque la date pour ne pas la confondre)
    masked = lab
    if out["date_str"]:
        s, e = spans[-1][1], spans[-1][2]
        masked = lab[:s] + " " * (e - s) + lab[e:]
    m = re.search(r"(\d+(?:[.,]\d+)?)\s*%", masked) or re.search(r"(?<![\d/])(\d+\.\d+)(?![\d/])", masked)
    if m:
        out["cpn_str"] = m.group(1)
        out["cpn"] = float(m.group(1).replace(",", "."))
        spans.append(("cpn", m.start(), m.end()))

    for tok, key in ((r"\bPERP\b", "perp"), (r"\bVAR\b|\bFRN\b", "var")):
        m = re.search(tok, lab)
        if m:
            out[key] = True
            spans.append((key, m.start(), m.end()))

    if spans:
        first = min(spans, key=lambda x: x[1])
        out["iss"] = lab[:first[1]].strip(" -_/")
        out["first_token"] = first[0]
    else:
        out["iss"] = lab
    return out


# --------------------------- émetteur ---------------------------
def issuer_tokens(s):
    toks = re.sub(r"[^A-Z0-9 ]", " ", strip_apos(strip_paren(clean(s))).replace("/", " ")).split()
    toks = [SYNONYMS.get(t, t) for t in toks]
    toks = [ABBREV.get(MOTS_ABREGES.get(t, t), MOTS_ABREGES.get(t, t)) for t in toks]
    return [t for t in toks if t not in LEGAL_FORMS and t not in DROPPABLE]


def is_acronym(lbl_iss, ref_iss):
    """Émetteur du libellé = sigle, ticker ou nom tronqué (GS, F, ABI, BARC, SAN...)."""
    a, b = issuer_tokens(lbl_iss), issuer_tokens(ref_iss)
    if len(a) != 1 or not b or a[0] in b:
        return False
    initials = "".join(t[0] for t in b)
    if a[0] == initials or (len(a[0]) <= 2 and initials.startswith(a[0])):
        return True
    # mot unique court absent du nom Reuters : ticker Bloomberg ou nom tronqué (BARC, SAN, MCD, ENELIM...)
    return len(a[0]) <= 6


def drop_words(name):
    """Retire les mots de WORDS_REMOVED, sauf le premier mot."""
    toks = name.split()
    return " ".join(toks[:1] + [t for t in toks[1:] if t not in WORDS_REMOVED])


def issuer_score(lbl_iss, ref_iss):
    a, b = issuer_tokens(lbl_iss), issuer_tokens(ref_iss)
    if not a or not b:
        return 0
    if set(a) <= set(b):
        return 100
    if is_acronym(lbl_iss, ref_iss):                                # sigle / ticker (GS, F...) : refusé
        return 60
    if all(len(ta) >= 4 and any(tb.startswith(ta) and len(ta) >= 0.6 * len(tb) for tb in b)
           for ta in a):                                            # abréviations légères
        return 90
    return round(max(_ratio(" ".join(a), " ".join(b)), _ratio("".join(a), "".join(b))))


APOS = "'’‘`´"
APOS_RE = "[" + re.escape(APOS) + "]"


def strip_paren(s):
    """Supprime les parenthèses ET leur contenu : « ENEL (EX XYZ) » -> « ENEL » ;
    parenthèse non fermée : tout ce qui suit est supprimé."""
    s = re.sub(r"\([^()]*\)", " ", s)
    s = re.sub(r"\(.*$", " ", s)
    return re.sub(r"\s+", " ", s.replace(")", " ")).strip()


def strip_apos(s):
    """MOODY'S -> MOODYS ; D'INFRASTRUCTURE -> INFRASTRUCTURE ; L'ENVIRONNEMENT -> ENVIRONNEMENT ;
    toute autre apostrophe est supprimée (O'REILLY -> OREILLY)."""
    s = re.sub(r"\b[LD]" + APOS_RE + r"(?=\w)", "", s)
    return re.sub(APOS_RE, "", s)


def strip_amp(s):
    """Supprime les « & Co », « & Co. », « & Cie »... (et ce qui suit), puis tout « & » restant."""
    s = re.sub(r"\s*&\s*(CO|CIE|COMPANY)\b\.?.*$", "", s)
    return re.sub(r"\s+", " ", s.replace("&", " ")).strip()


def short_name(ref_iss):
    toks = strip_apos(strip_amp(strip_paren(clean(ref_iss)))).replace("/", " ").replace(",", " ").split()
    while len(toks) > 1 and toks[-1].replace(".", "") in LEGAL_FORMS:
        toks.pop()
    if len(toks) > 1 and toks[0] == "THE":
        toks.pop(0)
    return " ".join(toks)


def fit_issuer(iss, budget):
    """Fait tenir l'émetteur dans `budget` caractères en n'utilisant QUE les listes de la config.
    Retourne (nom, tient). Aucune coupe de mot, aucun mot retiré hors liste."""
    toks = iss.split()
    fits = lambda: len(" ".join(toks)) <= budget
    if fits():
        return " ".join(toks), True
    # 1) émetteur (ou début de nom) remplacé en entier
    full = " ".join(toks)
    for long_name, short in sorted(EMETTEURS_COURTS.items(), key=lambda kv: -len(kv[0])):
        if full == long_name or full.startswith(long_name + " "):
            toks = (short + full[len(long_name):]).split()
            break
    # 2) mots supprimables (jamais le premier), de la fin vers le début
    for i in reversed(range(1, len(toks))):
        if fits():
            break
        if toks[i] in MOTS_SUPPRIMABLES:
            toks.pop(i)
    # 3) mots abrégés, de la fin vers le début
    for i in reversed(range(len(toks))):
        if fits():
            break
        toks[i] = MOTS_ABREGES.get(toks[i], toks[i])
    return " ".join(toks), fits()


def to_date(x):
    """Maturité Reuters : datetime, ISO (2029-01-14) ou français (14/01/2029)."""
    if pd.isna(x) or str(x).strip() == "":
        return None
    if isinstance(x, (pd.Timestamp, date)):
        return pd.Timestamp(x).date()
    s = str(x).strip().split(" ")[0]
    for f in ("%Y-%m-%d", "%d/%m/%Y", "%d.%m.%Y", "%d-%m-%Y", "%Y%m%d"):
        try:
            return pd.to_datetime(s, format=f).date()
        except ValueError:
            pass
    return None


